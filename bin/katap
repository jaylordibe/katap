#!/usr/bin/env bash
#
# katap — run several containerized projects on one host, behind one Caddy.
#
# Katap is a tool: install.sh puts a release at /srv/katap and running it again
# upgrades. Nothing about your projects lives in this repository. /srv/katap.json
# says which projects and components this host runs; `katap apply` creates them. A
# project is a directory under $KATAP_PROJECTS (default /srv/projects) holding one
# compose file per component (copied from templates/ by `katap add`), a
# <component>.conf of deploy settings, and site.caddy. Secrets live under
# /srv/secrets, never in a repository.
#
#   katap apply [--yes]                                  create what /srv/katap.json declares
#   katap env <project> <component>                      edit a component's settings
#   katap deploy-key <project> <component> [--replace]   make its restricted deploy key
#   katap remove <project> [<component>] --confirm <project>
#                                                        remove what was never deployed
#   katap add <project> <type> <component> [domain...]   define one component by hand
#   katap secrets <project> <component>                  generate its secrets ONCE
#   katap edge up|reload                                 start the shared edge / reload its config
#   katap edge cloudflare [<origin.pem> <origin.key>]    serve behind Cloudflare's proxy
#   katap edge acme                                      back to Let's Encrypt
#   katap deploy <project> <component> <image@sha256:…> [migrate=<image@sha256:…>]
#   katap rollback <project> <component> [<image@sha256:…> [migrate=<image@sha256:…>]]
#   katap run <project> <service> [args...]              one-off command in a one-shot service
#   katap cron --all | <project>                         per-minute jobs (systemd timer)
#   katap backup --all | <project>                       database dumps (systemd timer)
#   katap restore <project> <component> <dump> --confirm <project>
#   katap check [<project>...]                           enforce the project contract
#   katap images prune                                   remove images no release needs
#   katap ssh-dispatch <environment> <project> <component>[,<component>...]
#                                                        forced command of an app's deploy key
#
# Host layout (KATAP_SRV, default /srv):
#   katap.json                                             the projects apply creates
#   projects/<project>/<component>.yml, .conf, site.caddy  what runs (KATAP_PROJECTS)
#   edge/edge.env                                          this host's edge settings
#   secrets/<project>/<component>.env, .db.env, -db-tls/   0700 dir, 0600 files
#   state/<project>/images.env                             the digests now serving
#   state/<project>/history                                every deploy and rollback
#   state/.dispatch/<project>/                             each CI dispatch's log
#   backups/<project>/<component>-<time>-<reason>.dump
# Host settings: /etc/katap/katap.env (KATAP_RCLONE_REMOTE, KATAP_BACKUP_KEEP, ...).
# The installed release: /etc/katap/release (tag= and commit=, written by install.sh).
#
# Nothing here ever regenerates a secret, drops a database or volume, or runs a
# destructive migration. `restore` replaces data and is never reachable from CI.
set -euo pipefail
shopt -s nullglob
# bash 5.2 expands `&` in a ${var//pattern/replacement} replacement; a generated
# secret is substituted literally.
shopt -u patsub_replacement 2>/dev/null || true

if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    echo "katap: bash 4 or newer is required (this is ${BASH_VERSION})." >&2
    exit 1
fi

KATAP_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Host settings. The systemd units and ssh-dispatch reach the same values: a
# dispatched deploy needs the backup remote too. Read as data, never sourced,
# and only these keys; the environment wins. This is the file's only reader (the
# systemd units do not load it), so its rules are these: the last line for a key
# wins, surrounding whitespace and one pair of quotes are removed. Not exported:
# every katap process reads it itself.
KATAP_SETTINGS="${KATAP_SETTINGS:-/etc/katap/katap.env}"
if [ -r "$KATAP_SETTINGS" ]; then
    for _key in KATAP_RCLONE_REMOTE KATAP_BACKUP_KEEP KATAP_CRON_TIMEOUT KATAP_DISPATCH_COOLDOWN KATAP_RELEASES_KEPT; do
        if [ -z "${!_key:-}" ] && _line="$(grep -E "^${_key}=" "$KATAP_SETTINGS" | tail -n 1)"; then
            _line="${_line#*=}"
            _line="${_line%$'\r'}"
            _line="${_line#"${_line%%[![:space:]]*}"}"
            _line="${_line%"${_line##*[![:space:]]}"}"
            if [[ "$_line" =~ ^\"(.*)\"$ ]] || [[ "$_line" =~ ^\'(.*)\'$ ]]; then
                _line="${BASH_REMATCH[1]}"
            fi
            printf -v "$_key" '%s' "$_line"
        fi
    done
    unset _key _line
fi

# The registry login of one dispatched deploy: ssh-dispatch writes it to a 0600
# file it alone created and passes the path. It is read once and the file
# removed at once, and it is never exported: no child process but the one
# `docker login` that reads it on standard input ever sees it.
REGISTRY_USER=''
REGISTRY_TOKEN=''
if [ -n "${KATAP_REGISTRY_FILE:-}" ]; then
    if [ -f "$KATAP_REGISTRY_FILE" ]; then
        IFS=' ' read -r REGISTRY_USER REGISTRY_TOKEN < "$KATAP_REGISTRY_FILE" || true
        rm -f "$KATAP_REGISTRY_FILE"
    fi
    unset KATAP_REGISTRY_FILE
fi

KATAP_SRV="${KATAP_SRV:-/srv}"
KATAP_PROJECTS="${KATAP_PROJECTS:-$KATAP_SRV/projects}"
KATAP_PROJECTS_FILE="${KATAP_PROJECTS_FILE:-$KATAP_SRV/katap.json}"
KATAP_RELEASE_FILE="${KATAP_RELEASE_FILE:-/etc/katap/release}"
KATAP_HOST_KEY_FILE="${KATAP_HOST_KEY_FILE:-/etc/ssh/ssh_host_ed25519_key.pub}"
# Test seams: the docker binary, the program ssh-dispatch hands over to, and the
# deploy user's authorized_keys.
KATAP_DOCKER="${KATAP_DOCKER:-docker}"
KATAP_SELF="${KATAP_SELF:-$KATAP_ROOT/bin/katap}"
KATAP_AUTHORIZED_KEYS="${KATAP_AUTHORIZED_KEYS:-$HOME/.ssh/authorized_keys}"
KATAP_BACKUP_KEEP="${KATAP_BACKUP_KEEP:-14}"
# Earlier releases kept per component, so a rollback never needs the registry.
KATAP_RELEASES_KEPT="${KATAP_RELEASES_KEPT:-5}"

# Runs lib/smoke-check.sh on a project network. Pinned like every other image.
CURL_IMAGE='curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777'

PROJECT_RE='^[a-z][a-z0-9-]{0,29}$'
# No hyphen: the component name becomes part of an environment variable name.
COMPONENT_RE='^[a-z][a-z0-9]{0,19}$'
# The registry login a deploy may carry: a GitHub user (or app bot, or Enterprise
# Managed User) and a GitHub Actions job token. action/deploy.sh sends exactly
# these; tests/run.sh checks the two copies are the same.
REGISTRY_USER_RE='^[A-Za-z0-9][A-Za-z0-9_-]{0,99}(\[bot\])?$'
JOB_TOKEN_RE='^ghs_[A-Za-z0-9]{20,255}$'
DOMAIN_RE='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
# owner/name, as GitHub allows: no dots in the owner, and a name that is not only dots.
REPO_RE='^[A-Za-z0-9-]+/[A-Za-z0-9_.-]*[A-Za-z0-9_-][A-Za-z0-9_.-]*$'
# An image repository: lowercase, no tag and no digest (release_lines adds those).
IMAGE_RE='^[a-z0-9][a-z0-9.-]*(:[0-9]+)?(/[a-z0-9._-]+)+$'
IPV4_RE='^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$'
DIGEST_SUFFIX_RE='@sha256:[0-9a-f]{64}$'

die() { echo "katap: $*" >&2; exit 1; }

# Temporary paths removed on exit, however the command ends.
CLEANUP=()
# Set while a pasted secret is read with echo off, so an interrupted paste still
# gives the terminal its echo back.
TTY_ECHO_OFF=false
cleanup() {
    [ "$TTY_ECHO_OFF" = false ] || stty echo < /dev/tty 2>/dev/null || true
    [ "${#CLEANUP[@]}" -eq 0 ] || rm -rf -- "${CLEANUP[@]}"
}
trap cleanup EXIT
log() { echo "katap: $*" >&2; }

# --- Names and files ------------------------------------------------------------

valid_project() { [[ "$1" =~ $PROJECT_RE ]] || die "invalid project name '$1' (expected ${PROJECT_RE})."; }
valid_component() { [[ "$1" =~ $COMPONENT_RE ]] || die "invalid component name '$1' (expected ${COMPONENT_RE})."; }

project_dir() { printf '%s/%s' "$KATAP_PROJECTS" "$1"; }
secrets_dir() { printf '%s/secrets/%s' "$KATAP_SRV" "$1"; }
state_dir() { printf '%s/state/%s' "$KATAP_SRV" "$1"; }
images_file() { printf '%s/images.env' "$(state_dir "$1")"; }
conf_file() { printf '%s/%s.conf' "$(project_dir "$1")" "$2"; }

upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

require_project() {
    valid_project "$1"
    [ -d "$(project_dir "$1")" ] || die "unknown project '$1' (no $(project_dir "$1"))."
}

require_component() {
    require_project "$1"
    valid_component "$2"
    [ -f "$(conf_file "$1" "$2")" ] || die "unknown component '$2' in project '$1'."
}

# Reads one key from a KEY=VALUE file as data. Never sourced: these files are
# inputs, and nothing in them is executed.
file_get() {
    local file="$1" key="$2" line
    line="$(grep -E "^${key}=" "$file" | head -n 1 || true)"
    printf '%s' "${line#*=}"
}

conf_get() { file_get "$(conf_file "$1" "$2")" "$3"; }

# Edge settings: edge/edge.env holds the defaults; this host's
# $KATAP_SRV/edge/edge.env overrides them key by key, so a host never edits the
# tool's checkout. edge_get and edge_compose read the same list in the same order:
# CADDY_IP and the TLS mode are baked into secrets, so the two must never disagree.
edge_env_files() {
    printf '%s\n' "$KATAP_ROOT/edge/edge.env"
    [ ! -f "$KATAP_SRV/edge/edge.env" ] || printf '%s\n' "$KATAP_SRV/edge/edge.env"
}

edge_get() {
    local file value=''
    while IFS= read -r file; do
        ! grep -qE "^${1}=" "$file" || value="$(file_get "$file" "$1")"
    done < <(edge_env_files)
    printf '%s' "$value"
}

components_of() {
    local f
    for f in "$(project_dir "$1")"/*.conf; do
        basename "$f" .conf
    done
}

all_projects() {
    local d
    for d in "$KATAP_PROJECTS"/*/; do
        basename "$d"
    done
}

# --- Compose ----------------------------------------------------------------------

# docker compose for one project, every component file merged, with the release
# digests from <env file>.
compose_with() {
    local project="$1" env_file="$2"
    shift 2
    local files=() f
    for f in "$(project_dir "$project")"/*.yml; do
        files+=(-f "$f")
    done
    [ "${#files[@]}" -gt 0 ] || die "project '$project' has no components."

    # From /: compose reads the working directory even with --project-directory,
    # and `sudo -u deploy` keeps the caller's, often a home directory deploy cannot
    # read. Every path given to compose is absolute.
    (cd / && KATAP_ROOT="$KATAP_ROOT" KATAP_PROJECT="$project" KATAP_SECRETS="$(secrets_dir "$project")" \
        "$KATAP_DOCKER" compose --project-name "$project" --project-directory "$(project_dir "$project")" \
        --env-file "$env_file" "${files[@]}" "$@")
}

ensure_state() {
    local dir
    dir="$(state_dir "$1")"
    mkdir -p "$dir"
    [ -f "$dir/images.env" ] || : > "$dir/images.env"
}

compose() {
    local project="$1"
    shift
    ensure_state "$project"
    compose_with "$project" "$(images_file "$project")" "$@"
}

# --- add ------------------------------------------------------------------------

cmd_add() {
    [ "$#" -ge 3 ] || die "usage: katap add <project> <type> <component> [domain...]"
    local project="$1" type="$2" component="$3"
    shift 3
    valid_project "$project"
    valid_component "$component"
    if [ ! -f "$KATAP_ROOT/templates/$type.yml" ]; then
        local known=() template
        for template in "$KATAP_ROOT"/templates/*.yml; do
            known+=("$(basename "$template" .yml)")
        done
        die "unknown type '$type'. Types: ${known[*]}"
    fi

    local domain
    for domain in "$@"; do
        [[ "$domain" =~ $DOMAIN_RE ]] || die "invalid domain '$domain'."
    done

    local dir cu
    dir="$(project_dir "$project")"
    cu="$(upper "$component")"
    mkdir -p "$dir"
    [ ! -e "$dir/$component.yml" ] && [ ! -e "$dir/$component.conf" ] \
        || die "component '$component' already exists in project '$project'."

    # Names are validated above to [a-z0-9-], so they are safe sed replacements.
    # The .conf is written last: it is what marks the component as created, so an
    # interrupted add leaves a component that is visibly half-made, never one
    # that looks complete without its site block.
    sed -e "s/__C__/$component/g" -e "s/__CU__/$cu/g" "$KATAP_ROOT/templates/$type.yml" > "$dir/$component.yml"

    if [ "$#" -gt 0 ] && [ -f "$KATAP_ROOT/templates/$type.site" ]; then
        local port domains
        port="$(file_get "$KATAP_ROOT/templates/$type.conf" port)"
        domains="$(printf '%s, ' "$@")"
        domains="${domains%, }"
        local separator=''
        [ ! -s "$dir/site.caddy" ] || separator=$'\n'
        {
            printf '%s' "$separator"
            sed -e "s/__C__/$component/g" -e "s/__DOMAINS__/$domains/" \
                -e "s/__UPSTREAM__/$project-$component:$port/" "$KATAP_ROOT/templates/$type.site"
        } >> "$dir/site.caddy"
    fi
    local conf_tmp
    conf_tmp="$(mktemp "$dir/.$component.conf.XXXXXX")"
    sed -e "s/__C__/$component/g" -e "s/__CU__/$cu/g" -e "s/__DOMAINS__/$*/" "$KATAP_ROOT/templates/$type.conf" > "$conf_tmp"
    chmod 0644 "$conf_tmp"
    mv "$conf_tmp" "$dir/$component.conf"

    cat <<EOF
Added $type component '$component' to project '$project' ($dir).
Next:
  1. In $dir/$component.conf, set image= (and image_migrate= if present).
  2. katap secrets $project $component, then fill every empty required value.
  3. katap check $project$( [ "$#" -eq 0 ] || printf ', then katap edge reload to serve %s' "$*").
EOF
}

# --- secrets --------------------------------------------------------------------

pem_one_line() { awk 'BEGIN { ORS = "" } { if (NR > 1) printf "\\n"; printf "%s", $0 }' "$1"; }

cmd_secrets() {
    [ "$#" -eq 2 ] || die "usage: katap secrets <project> <component>"
    local project="$1" component="$2"
    require_component "$project" "$component"

    local type spec dir tls_dir
    type="$(conf_get "$project" "$component" type)"
    spec="$KATAP_ROOT/templates/$type.env.spec"
    [ -f "$spec" ] || die "no secret spec for type '$type'."
    dir="$(secrets_dir "$project")"
    tls_dir="$dir/$component-db-tls"

    # Each spec section is one file, read only by the containers that need it.
    declare -A section_file=([app]="$dir/$component.env" [db]="$dir/$component.db.env" [redis]="$dir/$component.redis.env")

    # Generated once. Regenerating APP_KEY, Passport keys or a database password
    # breaks every token, every encrypted value and the database login.
    local existing
    for existing in "${section_file[@]}" "$tls_dir"; do
        [ ! -e "$existing" ] || die "secrets for '$project/$component' already exist in $dir; refusing to overwrite them."
    done

    umask 077
    mkdir -p "$dir"
    chmod 700 "$dir"

    local domain cloudflare caddy_ip frontend_url frontend_origins
    domain="$(conf_get "$project" "$component" domains)"
    domain="${domain%% *}"
    frontend_url="$(frontend_of "$project" "$component" url)"
    frontend_origins="$(frontend_of "$project" "$component" origins)"
    caddy_ip="$(edge_get CADDY_IP)"
    cloudflare=false
    [ "$(edge_get TLS_MODE)" != cloudflare ] || cloudflare=true

    # Inside the 0700 secrets directory, so nothing generated is ever readable
    # elsewhere, even briefly.
    local work
    work="$(mktemp -d "$dir/.work.XXXXXX")"
    CLEANUP+=("$work")

    declare -A value=()
    local section='' line key generator out pair name
    for name in "${!section_file[@]}"; do
        : > "$work/$name"
    done

    while IFS= read -r line || [ -n "$line" ]; do
        line="${line//__C__/$component}"
        case "$line" in
            ''|'#'*) continue ;;
            '['*']')
                section="${line#[}"
                section="${section%]}"
                [ -n "${section_file[$section]+set}" ] || die "$spec: unknown section '$line'."
                continue
                ;;
        esac
        [ -n "$section" ] || die "$spec: '$line' is outside a section."
        key="${line%%=*}"
        generator="${line#*=}"
        [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "$spec: invalid key in '$line'."

        case "$generator" in
            hex:*)
                out="$(openssl rand -hex "${generator#hex:}")"
                ;;
            laravel-key)
                out="base64:$(openssl rand -base64 32)"
                ;;
            rsa-private:*|rsa-public:*)
                pair="${generator#*:}"
                if [ ! -f "$work/$pair.key" ]; then
                    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out "$work/$pair.key" 2>/dev/null
                    openssl pkey -in "$work/$pair.key" -pubout -out "$work/$pair.pub" 2>/dev/null
                fi
                if [ "${generator%%:*}" = rsa-private ]; then
                    out="$(pem_one_line "$work/$pair.key")"
                else
                    out="$(pem_one_line "$work/$pair.pub")"
                fi
                ;;
            same:*)
                [ -n "${value[${generator#same:}]+set}" ] || die "$spec: '$key' refers to '${generator#same:}' before it is defined."
                out="${value[${generator#same:}]}"
                ;;
            literal:*)
                out="${generator#literal:}"
                out="${out//\{project\}/$project}"
                out="${out//\{component\}/$component}"
                out="${out//\{domain\}/$domain}"
                out="${out//\{caddy_ip\}/$caddy_ip}"
                out="${out//\{cloudflare\}/$cloudflare}"
                while [[ "$out" =~ \{secret:([A-Z][A-Z0-9_]*)\} ]]; do
                    [ -n "${value[${BASH_REMATCH[1]}]+set}" ] || die "$spec: '$key' uses secret '${BASH_REMATCH[1]}' before it is defined."
                    out="${out//\{secret:${BASH_REMATCH[1]}\}/${value[${BASH_REMATCH[1]}]}}"
                done
                ;;
            frontend:url|frontend:origins)
                out="$frontend_url"
                [ "$generator" = frontend:url ] || out="$frontend_origins"
                if [ -z "$out" ]; then
                    printf '# katap:required\n%s=\n' "$key" >> "$work/$section"
                    value[$key]=''
                    continue
                fi
                ;;
            required)
                printf '# katap:required\n%s=\n' "$key" >> "$work/$section"
                value[$key]=''
                continue
                ;;
            *)
                die "$spec: unknown generator '$generator' for '$key'."
                ;;
        esac

        value[$key]="$out"
        printf '%s=%s\n' "$key" "$out" >> "$work/$section"
    done < "$spec"

    if grep -qF "\${KATAP_SECRETS}/$component-db-tls" "$(project_dir "$project")/$component.yml"; then
        mkdir -p "$work/tls"
        openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=$component-db" \
            -keyout "$work/tls/server.key" -out "$work/tls/server.crt" 2>/dev/null
        chmod 600 "$work/tls/server.key" "$work/tls/server.crt"
    fi

    # Everything is made before anything is moved into place, and the app's file
    # last: it is what marks the secrets as made.
    chmod 600 "$work/db" "$work/redis" "$work/app"
    mv "$work/db" "${section_file[db]}"
    mv "$work/redis" "${section_file[redis]}"
    [ ! -d "$work/tls" ] || mv "$work/tls" "$tls_dir"
    mv "$work/app" "${section_file[app]}"

    echo "Wrote ${section_file[app]} and its database and Redis files (mode 0600). Fill every empty value marked '# katap:required' before the first deploy."
}

# The frontend a component's API serves: the one spa or node-ssr component of
# its project that has domains. <what> is `url` (https:// and its first domain)
# or `origins` (https:// and every domain, comma-separated). Nothing when the
# project has none or several: which one is the frontend is then the operator's
# to say.
frontend_of() {
    local project="$1" component="$2" what="$3" other found='' type domains
    for other in $(components_of "$project"); do
        [ "$other" != "$component" ] || continue
        type="$(conf_get "$project" "$other" type)"
        domains="$(conf_get "$project" "$other" domains)"
        case "$type" in spa|node-ssr) ;; *) continue ;; esac
        [ -n "$domains" ] || continue
        [ -z "$found" ] || return 0
        found="$domains"
    done
    [ -n "$found" ] || return 0
    if [ "$what" = url ]; then
        printf 'https://%s' "${found%% *}"
    else
        local list=() names d
        read -ra names <<<"$found"
        for d in "${names[@]}"; do list+=("https://$d"); done
        (IFS=,; printf '%s' "${list[*]}")
    fi
}

# The keys still empty under a '# katap:required' marker in a component's
# secret files, one per line.
empty_required() {
    local file
    file="$(secrets_dir "$1")/$2.env"
    local files=("$file")
    [ ! -f "${file%.env}.db.env" ] || files+=("${file%.env}.db.env")
    [ ! -f "${file%.env}.redis.env" ] || files+=("${file%.env}.redis.env")
    awk '/^# katap:required$/ { getline; if ($0 ~ /^[A-Z0-9_]+=$/) print substr($0, 1, length($0) - 1) }' "${files[@]}"
}

# Refuses a deploy while a required value is still empty.
require_filled_secrets() {
    local project="$1" component="$2" file
    file="$(secrets_dir "$project")/$component.env"
    [ -f "$file" ] || die "no secrets for '$project/$component'; run 'katap secrets $project $component' on this host first."
    local missing
    missing="$(empty_required "$project" "$component")"
    [ -z "$missing" ] || die "required values are empty in $file: $(echo "$missing" | tr '\n' ' ')"
}

# --- check ----------------------------------------------------------------------

# Whether check_project also holds declared components to katap.json. A rollback
# sets it false: the way back must never depend on a file being edited.
CHECK_DRIFT=true

# The project contract, enforced on the merged compose configuration rendered with
# placeholder digests and empty secret files.
check_project() {
    local project="$1"
    require_project "$project"
    local fixture
    fixture="$(mktemp -d)"
    CLEANUP+=("$fixture")

    local component cu
    : > "$fixture/images.env"
    mkdir -p "$fixture/secrets"
    for component in $(components_of "$project"); do
        cu="$(upper "$component")"
        printf 'IMAGE_%s=registry.invalid/katap/check@sha256:%064d\nIMAGE_%s_MIGRATE=registry.invalid/katap/check@sha256:%064d\n' \
            "$cu" 0 "$cu" 0 >> "$fixture/images.env"
        : > "$fixture/secrets/$component.env"
        : > "$fixture/secrets/$component.db.env"
        : > "$fixture/secrets/$component.redis.env"
        mkdir -p "$fixture/secrets/$component-db-tls"
    done

    local files=() f config
    for f in "$(project_dir "$project")"/*.yml; do
        files+=(-f "$f")
    done
    # From /, as compose_with does.
    config="$(cd / && KATAP_ROOT="$KATAP_ROOT" KATAP_PROJECT="$project" KATAP_SECRETS="$fixture/secrets" \
        "$KATAP_DOCKER" compose --project-name "$project" --project-directory "$(project_dir "$project")" \
        --env-file "$fixture/images.env" --profile '*' "${files[@]}" config --format json)" \
        || die "project '$project': the compose files do not render."

    local problems
    problems="$(jq -r '
        .services | to_entries[] | .key as $name | .value as $s |
        ( if (($s.ports // []) | length) > 0 then "\($name): publishes ports; only the edge may" else empty end ),
        ( if ($s.image // "" | test("@sha256:[0-9a-f]{64}$") | not) then "\($name): image \"\($s.image // "(build)")\" is not pinned by digest" else empty end ),
        ( if $s.privileged == true then "\($name): privileged" else empty end ),
        ( if ($s.network_mode // "") == "host" then "\($name): host networking" else empty end ),
        ( if ($s.pid // "") == "host" then "\($name): host PID namespace" else empty end ),
        ( if any(($s.volumes // [])[]; (.source // "") | test("docker\\.sock")) then "\($name): mounts the Docker socket" else empty end ),
        ( if (($s.profiles // []) | length) == 0 and (($s.healthcheck // {}) | .disable == true) then "\($name): healthcheck disabled" else empty end ),
        ( if (($s.profiles // []) | length) == 0 and ($s.healthcheck == null) then "\($name): long-running service without a healthcheck" else empty end ),
        ( if (($s.profiles // []) | length) > 0 and (($s.restart // "no") != "no") then "\($name): a one-shot service must not restart" else empty end ),
        ( if ($s.image // "" | test("^(docker\\.io/)?(library/)?(postgres|redis|mysql|mariadb|mongo)[:@]")) and (($s.networks // {}) | has("edge")) then "\($name): a data service is on the edge network" else empty end ),
        ( if ($s.hostname // "") != "" then "\($name): a fixed hostname (worker health keys on it)" else empty end ),
        ( if (($s.cap_add // []) | length) > 0 then "\($name): adds Linux capabilities" else empty end ),
        ( if (($s.devices // []) | length) > 0 then "\($name): maps host devices" else empty end ),
        ( if ($s.ipc // "") == "host" then "\($name): host IPC namespace" else empty end ),
        ( if [($s.network_mode // ""), ($s.pid // ""), ($s.ipc // "")] | any(startswith("container:")) then "\($name): shares another container'"'"'s namespace" else empty end ),
        ( if ($s.userns_mode // "") == "host" then "\($name): host user namespace" else empty end ),
        ( if any(($s.security_opt // [])[]; test("unconfined")) then "\($name): an unconfined security profile" else empty end ),
        ( if any(($s.volumes // [])[]; .type == "bind" and ((.source // "") | test("^/(etc|proc|sys|root|boot|dev|var/lib/docker)?/?$|^/(etc|proc|sys|root|boot|dev|var/lib/docker)/"))) then "\($name): bind-mounts a host system path" else empty end )
    ' <<<"$config")"
    # A project joins no network but its own and the edge: another project's
    # network is another project's data services.
    problems+=$'\n'"$(jq -r '
        .networks // {} | to_entries[]
        | select(.value.external == true and .value.name != "katap-edge")
        | "network \(.value.name): an external network other than katap-edge"
    ' <<<"$config")"
    local site
    site="$(project_dir "$project")/site.caddy"
    if [ -f "$site" ] && grep -nE '^[[:space:]]*reverse_proxy' "$site" >/dev/null; then
        problems+=$'\n'"site.caddy: a bare reverse_proxy; proxy through 'import katap_proxy', which sets the client address"
    fi

    local key name services line
    services="$(jq -r '.services | keys[]' <<<"$config")"
    for component in $(components_of "$project"); do
        for key in predeploy rollout cron smoke_service backup; do
            for name in $(conf_get "$project" "$component" "$key"); do
                grep -qxF -- "$name" <<<"$services" \
                    || problems+=$'\n'"$component.conf: $key names '$name', which is not a service"
            done
        done
        case "$(conf_get "$project" "$component" environment)" in
            production|staging) ;;
            *) problems+=$'\n'"$component.conf: environment= must be production or staging" ;;
        esac
        for name in $(conf_get "$project" "$component" predeploy); do
            jq -e --arg n "$name" '.services[$n].profiles // [] | index("predeploy")' <<<"$config" >/dev/null 2>&1 \
                || problems+=$'\n'"$component.conf: predeploy service '$name' is not in the predeploy profile"
        done
        for name in $(conf_get "$project" "$component" cron); do
            jq -e --arg n "$name" '.services[$n].profiles // [] | index("cron")' <<<"$config" >/dev/null 2>&1 \
                || problems+=$'\n'"$component.conf: cron service '$name' is not in the cron profile"
        done
    done

    # What katap.json declares is what may deploy: a .conf edited away from it, or
    # a katap.json changed without `katap apply`, is refused until the two agree.
    # Only this project's part of the file is held against it: an edit to another
    # project not applied yet does not hold this project's deploys. A file that
    # does not parse holds every deploy.
    if [ -f "$KATAP_PROJECTS_FILE" ] && [ "$CHECK_DRIFT" = true ]; then
        local own err file="$KATAP_PROJECTS_FILE"
        own="$(mktemp)"
        CLEANUP+=("$own")
        if ! jq --arg p "$project" '{host: (.host // ""), projects: (if (.projects // {}) | has($p) then {($p): .projects[$p]} else {} end)}' \
            "$file" > "$own" 2>/dev/null; then
            problems+=$'\n'"$file does not parse; fix it and run 'katap apply'"
        elif ! err="$(load_projects_file "$own" 2>&1)"; then
            problems+=$'\n'"$file: ${err##*"$own": }; fix it and run 'katap apply'"
        else
            # Loaded for this project alone: a check of several projects reads each afresh.
            WANTED=(); WANTED_LIST=(); WANTED_LOADED=false
            load_projects_file "$own"
            for component in $(components_of "$project"); do
                [ -n "${WANTED[$project/$component/type]+set}" ] || continue
                for key in type "${JSON_KEYS[@]}"; do
                    [ "$(conf_get "$project" "$component" "$key")" = "${WANTED[$project/$component/$key]}" ] \
                        || problems+=$'\n'"$component.conf: $key differs from $KATAP_PROJECTS_FILE; run 'katap apply'"
                done
                local names
                read -ra names <<<"${WANTED[$project/$component/domains]}"
                for name in "${names[@]}"; do
                    site_serves "$site" "$name" \
                        || log "WARNING: $project/$component: '$name' is not in $site; add it there and run 'katap edge reload'."
                done
            done
        fi
    fi

    problems="$(sed '/^$/d' <<<"$problems")"
    if [ -n "$problems" ]; then
        echo "katap: project '$project' breaks the project contract:" >&2
        while IFS= read -r line; do
            echo "  - $line" >&2
        done <<<"$problems"
        return 1
    fi
}

cmd_check() {
    local projects=("$@") project failed=0
    [ "${#projects[@]}" -gt 0 ] || mapfile -t projects < <(all_projects)
    for project in "${projects[@]}"; do
        if check_project "$project"; then
            echo "katap: project '$project' meets the project contract."
        else
            failed=1
        fi
    done
    return "$failed"
}

# --- edge -----------------------------------------------------------------------

edge_compose() {
    local env_files=() file
    while IFS= read -r file; do
        env_files+=(--env-file "$file")
    done < <(edge_env_files)
    # From /, as compose_with does.
    (cd / && KATAP_SRV="$KATAP_SRV" KATAP_PROJECTS="$KATAP_PROJECTS" "$KATAP_DOCKER" compose \
        --project-directory "$KATAP_ROOT/edge" "${env_files[@]}" -f "$KATAP_ROOT/edge/compose.yml" "$@")
}

edge_reload() {
    mkdir -p "$KATAP_SRV/state"
    exec 8>"$KATAP_SRV/state/.edge.lock"
    flock -w 120 8 || { log "another edge reload is still running."; return 1; }
    if [ -z "$(edge_compose ps -q caddy 2>/dev/null)" ]; then
        log "the edge is not running; start it with 'katap edge up'."
        exec 8>&-
        return 0
    fi
    # Validates before swapping: a broken site file leaves the old config serving.
    local status=0
    edge_compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile || status=1
    exec 8>&-
    return "$status"
}

cmd_edge() {
    case "${1:-}" in
        up)
            mkdir -p "$KATAP_SRV/edge/certs"
            edge_compose up -d --wait
            ;;
        reload)
            edge_reload || die "the edge rejected its configuration; the previous one keeps serving."
            ;;
        cloudflare)
            shift
            require_owner "edge cloudflare"
            edge_cloudflare "$@"
            ;;
        acme)
            [ "$#" -eq 1 ] || die "usage: katap edge acme"
            edge_acme
            ;;
        *)
            die "usage: katap edge up|reload|cloudflare|acme"
            ;;
    esac
}

# Sets KEY=value in an env file: the first line for the key is replaced, later
# ones dropped, a missing one appended. Written whole and renamed, keeping the
# file's mode; any failure leaves the file as it was and returns 1.
set_env_key() {
    local file="$1" key="$2" setting="$3" tmp
    tmp="$(mktemp "$file.XXXXXX")" || return 1
    CLEANUP+=("$tmp")
    KATAP_LINE="$key=$setting" awk -v k="$key" '
        index($0, k "=") == 1 { if (!done) { print ENVIRON["KATAP_LINE"]; done = 1 }; next }
        { print }
        END { if (!done) print ENVIRON["KATAP_LINE"] }
    ' "$file" > "$tmp" || return 1
    chmod --reference="$file" "$tmp" 2>/dev/null || true
    mv "$tmp" "$file" || return 1
}

# Every nestjs-api component's TRUST_CLOUDFLARE_HEADERS, set to <value>. The
# components whose running release needs a deploy to pick it up are left in
# TRUST_CHANGED. Dies on the first file it cannot write.
TRUST_CHANGED=()
set_cloudflare_trust() {
    local trust="$1" project component file
    TRUST_CHANGED=()
    for project in $(all_projects); do
        for component in $(components_of "$project"); do
            [ "$(conf_get "$project" "$component" type)" = nestjs-api ] || continue
            file="$(secrets_dir "$project")/$component.env"
            if [ ! -f "$file" ] || ! grep -q '^TRUST_CLOUDFLARE_HEADERS=' "$file"; then continue; fi
            [ "$(file_get "$file" TRUST_CLOUDFLARE_HEADERS)" != "$trust" ] || continue
            set_env_key "$file" TRUST_CLOUDFLARE_HEADERS "$trust" \
                || die "could not write $file; TRUST_CLOUDFLARE_HEADERS is unchanged there."
            TRUST_CHANGED+=("$project/$component")
        done
    done
}

# Reads one PEM block from the terminal: every line up to its END line. A private
# key is read without echo, so it never lands in the terminal's scrollback.
read_pem() {
    local what="$1" secret="${2:-}" line pem=''
    printf 'Paste the %s, then press Enter:\n' "$what" > /dev/tty
    if [ -n "$secret" ]; then TTY_ECHO_OFF=true; stty -echo < /dev/tty 2>/dev/null || true; fi
    while IFS= read -r line < /dev/tty; do
        pem+="$line"$'\n'
        [[ "$line" != -----END\ * ]] || break
    done
    [ -z "$secret" ] || { stty echo < /dev/tty 2>/dev/null || true; TTY_ECHO_OFF=false; printf '(received)\n' > /dev/tty; }
    printf '%s' "$pem"
}

# Behind Cloudflare's proxy: the edge serves a Cloudflare Origin CA certificate,
# admits only Cloudflare (its origin-pull client certificate and address ranges),
# and takes the client address from CF-Connecting-IP. Applications are told to
# trust Cloudflare's headers only once the edge admits nobody else.
edge_cloudflare() {
    local certs="$KATAP_SRV/edge/certs" cert key work name
    work="$(mktemp -d)"
    CLEANUP+=("$work")
    chmod 700 "$work"
    case "$#" in
        2)
            cp -- "$1" "$work/origin.pem" || die "cannot read $1 (the deploy user reads it; put it somewhere it can, or paste it: katap edge cloudflare)."
            cp -- "$2" "$work/origin.key" || die "cannot read $2 (the deploy user reads it; put it somewhere it can, or paste it: katap edge cloudflare)."
            ;;
        0)
            { : < /dev/tty; } 2>/dev/null || die "no terminal to paste on; run: katap edge cloudflare <origin.pem> <origin.key>"
            read_pem "Origin Certificate (from Cloudflare: SSL/TLS → Origin Server → Create Certificate)" > "$work/origin.pem"
            read_pem "Private Key that came with it" secret > "$work/origin.key"
            ;;
        *) die "usage: katap edge cloudflare [<origin.pem> <origin.key>]" ;;
    esac
    cert="$(openssl x509 -in "$work/origin.pem" -noout -pubkey 2>/dev/null)" || die "that is not a PEM certificate; nothing was changed."
    key="$(openssl pkey -in "$work/origin.key" -pubout 2>/dev/null)" || die "that is not a PEM private key; nothing was changed."
    [ "$cert" = "$key" ] || die "the private key does not belong to the certificate; nothing was changed."

    # The files in use are kept aside until the edge has started with the new ones.
    mkdir -p "$certs" "$work/previous"
    for name in origin.pem origin.key cf-origin-pull-ca.pem; do
        [ ! -f "$certs/$name" ] || cp -p -- "$certs/$name" "$work/previous/$name"
    done
    install -m 0644 "$work/origin.pem" "$certs/origin.pem"
    install -m 0600 "$work/origin.key" "$certs/origin.key"
    install -m 0644 "$KATAP_ROOT/edge/cloudflare-origin-pull-ca.pem" "$certs/cf-origin-pull-ca.pem"

    local edge_env="$KATAP_SRV/edge/edge.env" before
    [ -f "$edge_env" ] || (umask 022 && : > "$edge_env")
    before="$(edge_get TLS_MODE)"
    set_env_key "$edge_env" TLS_MODE cloudflare || die "could not write $edge_env; nothing else was changed."
    if ! edge_compose up -d --wait; then
        for name in origin.pem origin.key cf-origin-pull-ca.pem; do
            if [ -f "$work/previous/$name" ]; then cp -p -- "$work/previous/$name" "$certs/$name"; else rm -f -- "${certs:?}/$name"; fi
        done
        set_env_key "$edge_env" TLS_MODE "${before:-acme}" || true
        edge_compose up -d --wait || true
        die "the edge did not start in Cloudflare mode; it is back in ${before:-acme} mode with its previous certificate."
    fi
    set_cloudflare_trust true
    echo "The edge now admits only Cloudflare. Turn on SSL/TLS → Origin Server →"
    echo "Authenticated Origin Pulls → Global, and set SSL/TLS encryption to Full (strict)."
    if [ "${#TRUST_CHANGED[@]}" -gt 0 ]; then
        echo "Set TRUST_CLOUDFLARE_HEADERS=true for these; it takes effect on their next deploy:"
        printf '  %s\n' "${TRUST_CHANGED[@]}"
    fi
}

# Back to Let's Encrypt. Applications stop trusting Cloudflare's headers first,
# and the edge strips them outside Cloudflare mode: once it admits everyone, a
# client could otherwise set its own address.
edge_acme() {
    local edge_env="$KATAP_SRV/edge/edge.env" before
    set_cloudflare_trust false
    [ -f "$edge_env" ] || (umask 022 && : > "$edge_env")
    before="$(edge_get TLS_MODE)"
    set_env_key "$edge_env" TLS_MODE acme || die "could not write $edge_env; the edge is unchanged."
    if ! edge_compose up -d --wait; then
        # Back to the mode that was serving. Applications already distrust
        # Cloudflare's headers, which is safe in either mode.
        set_env_key "$edge_env" TLS_MODE "${before:-acme}" || true
        edge_compose up -d --wait || true
        die "the edge did not start in acme mode; it is back in ${before:-acme} mode. Check: docker compose -p katap-edge logs caddy"
    fi
    echo "The edge now gets its certificates from Let's Encrypt."
    if [ "${#TRUST_CHANGED[@]}" -gt 0 ]; then
        echo "Set TRUST_CLOUDFLARE_HEADERS=false for these; it takes effect on their next deploy"
        echo "(the edge already removes Cloudflare's headers from every request):"
        printf '  %s\n' "${TRUST_CHANGED[@]}"
    fi
}

# --- deploy / rollback ----------------------------------------------------------

# Prints the image lines for a release of one component, validating each reference
# against the repository its .conf allows.
release_lines() {
    local project="$1" component="$2"
    shift 2
    local cu image image_migrate main='' migrate='' arg
    cu="$(upper "$component")"
    image="$(conf_get "$project" "$component" image)"
    image_migrate="$(conf_get "$project" "$component" image_migrate)"

    [ -n "$image" ] && [[ "$image" != *OWNER/REPO* ]] || die "set image= in $(conf_file "$project" "$component")."

    for arg in "$@"; do
        case "$arg" in
            migrate=*) migrate="${arg#migrate=}" ;;
            *=*) die "unknown image target '${arg%%=*}'." ;;
            *) [ -z "$main" ] || die "more than one image given."; main="$arg" ;;
        esac
    done

    [ -n "$main" ] || die "no image given."
    [[ "$main" =~ $DIGEST_SUFFIX_RE ]] || die "'$main' is not pinned by digest (expected <repository>@sha256:<64 hex>)."
    [ "${main%@sha256:*}" = "$image" ] || die "'${main%@sha256:*}' is not this component's repository ($image)."
    printf 'IMAGE_%s=%s\n' "$cu" "$main"

    if [ -n "$image_migrate" ]; then
        [ -n "$migrate" ] || die "this component also needs migrate=<$image_migrate@sha256:…>."
        [[ "$migrate" =~ $DIGEST_SUFFIX_RE ]] || die "'$migrate' is not pinned by digest."
        [ "${migrate%@sha256:*}" = "$image_migrate" ] || die "'${migrate%@sha256:*}' is not this component's migrate repository ($image_migrate)."
        printf 'IMAGE_%s_MIGRATE=%s\n' "$cu" "$migrate"
    elif [ -n "$migrate" ]; then
        die "this component has no migrate image."
    fi
}

smoke() {
    local project="$1" component="$2" service port path body
    service="$(conf_get "$project" "$component" smoke_service)"
    port="$(conf_get "$project" "$component" port)"
    path="$(conf_get "$project" "$component" smoke_path)"
    body="$(conf_get "$project" "$component" smoke_body)"
    [ -n "$service" ] || return 0

    "$KATAP_DOCKER" run --rm --network "${project}_default" --entrypoint sh \
        -e SMOKE_ATTEMPTS -e SMOKE_INTERVAL_SECONDS \
        -v "$KATAP_ROOT/lib/smoke-check.sh:/katap/smoke-check.sh:ro" \
        "$CURL_IMAGE" /katap/smoke-check.sh "http://$service:$port$path" "$body"
}

rollout() {
    local project="$1" component="$2" env_file="$3" service
    for service in $(conf_get "$project" "$component" rollout); do
        log "starting $service."
        compose_with "$project" "$env_file" up -d --wait --wait-timeout 300 "$service" || return 1
    done
    smoke "$project" "$component"
}

# One lock per project, held by deploy, rollback, restore, backup and cron, so none
# of them ever runs against a project another one is changing.
lock_project() {
    ensure_state "$1"
    exec 9>"$(state_dir "$1")/.lock"
    flock -w "${2:-900}" 9 || die "another operation on '$1' is still running."
}

# lock_project without waiting: returns 1 when the project is busy.
try_lock_project() {
    ensure_state "$1"
    exec 9>"$(state_dir "$1")/.lock"
    flock -n 9 || { exec 9>&-; return 1; }
}

# git on the tool's own checkout. The .git is named outright, so git never falls
# back to an enclosing repository when this one cannot be read, and its ownership
# check (made only when it searches for a repository) never refuses the deploy
# user reading root's checkout; safe.directory says the same for any git that
# would. Hooks and fsmonitor are off, so reading it never runs anything.
tool_git() {
    git -c safe.directory="$KATAP_ROOT" -c core.hooksPath=/dev/null -c core.fsmonitor=false \
        --git-dir="$KATAP_ROOT/.git" --work-tree="$KATAP_ROOT" "$@"
}

# A deploy runs only a tool checkout without uncommitted changes to its tracked
# files, and, once install.sh has recorded a release in $KATAP_RELEASE_FILE, only
# that release's commit. Skipped only when the tool is not a git checkout at all;
# any git failure is a refusal, never a pass.
require_clean_tool() {
    [ -e "$KATAP_ROOT/.git" ] || return 0
    local out
    out="$(tool_git status --porcelain --untracked-files=no 2>&1)" \
        || die "could not check $KATAP_ROOT with git ($out); nothing was changed."
    [ -z "$out" ] \
        || die "$KATAP_ROOT has local modifications; restore it to a release (git -C $KATAP_ROOT status) before deploying."
    [ -f "$KATAP_RELEASE_FILE" ] || return 0
    local recorded head
    recorded="$(file_get "$KATAP_RELEASE_FILE" commit)"
    head="$(tool_git rev-parse HEAD 2>&1)" || die "could not read $KATAP_ROOT's commit ($head); nothing was changed."
    [ "$head" = "$recorded" ] \
        || die "$KATAP_ROOT is at ${head:0:12}, not the release install.sh installed (${recorded:0:12}, $KATAP_RELEASE_FILE); run install.sh again."
}

# Makes every image of <lines> (IMAGE_X=<repository>@sha256:… lines) present on
# this host, pulling only what is missing. An image already here is never pulled
# again: it is addressed by digest, so its content is the content that was
# deployed, and a rollback or a restore works with the registry unreachable.
# A pull from ghcr.io uses the registry login ssh-dispatch received for this
# deploy, when there is one, in a Docker config made for these pulls alone and
# removed afterwards. A pull without one (a rollback or restore run by hand) uses
# the deploy user's own Docker login, if someone made one. Each registry call
# has a deadline, so a stalled registry never holds the project's lock for long.
PULL_TIMEOUT=900
ensure_images() {
    local lines="$1" ref config=''
    while IFS= read -r ref; do
        ref="${ref#*=}"
        [ -n "$ref" ] || continue
        ! "$KATAP_DOCKER" image inspect "$ref" >/dev/null 2>&1 || continue
        log "pulling $ref."
        if [ -n "$REGISTRY_TOKEN" ] && [ "${ref%%/*}" = ghcr.io ]; then
            if [ -z "$config" ]; then
                config="$(mktemp -d)"
                CLEANUP+=("$config")
                chmod 700 "$config"
                printf '%s' "$REGISTRY_TOKEN" \
                    | DOCKER_CONFIG="$config" timeout -k 30 "$PULL_TIMEOUT" "$KATAP_DOCKER" login ghcr.io --username "$REGISTRY_USER" --password-stdin >/dev/null 2>&1 \
                    || die "could not log in to ghcr.io with this deploy's token; nothing was changed."
            fi
            DOCKER_CONFIG="$config" timeout -k 30 "$PULL_TIMEOUT" "$KATAP_DOCKER" pull --quiet "$ref" >/dev/null \
                || die "could not pull $ref; nothing was changed."
        else
            timeout -k 30 "$PULL_TIMEOUT" "$KATAP_DOCKER" pull --quiet "$ref" >/dev/null \
                || die "could not pull $ref; nothing was changed. A private image no longer on this host needs a registry login first: sudo -u deploy docker login ghcr.io (a token with read:packages), then docker logout ghcr.io afterwards."
        fi
    done <<<"$lines"
    [ -z "$config" ] || rm -rf "$config"
}

# deploy: pull → pre-deploy dump → predeploy one-shots → rollout → smoke → record.
# rollback: the same without the dump and the one-shots. Migrations only go
# forward; the previous release runs against the expanded schema.
release() {
    local mode="$1" project="$2" component="$3"
    shift 3
    require_component "$project" "$component"
    # Before the .conf is read: apply rewrites it under this lock, so every check
    # below and the rollout see one version of it.
    lock_project "$project"
    require_filled_secrets "$project" "$component"

    local images=() arg
    for arg in "$@"; do
        case "$arg" in
            env=*)
                # Set by ssh-dispatch from the key's forced command, never by the request:
                # a staging key cannot touch a production component on a shared host.
                [ "${arg#env=}" = "$(conf_get "$project" "$component" environment)" ] \
                    || die "'$project/$component' is a $(conf_get "$project" "$component" environment) component; this key deploys ${arg#env=} only."
                ;;
            *) images+=("$arg") ;;
        esac
    done
    set -- "${images[@]}"

    [ "$mode" != deploy ] || require_clean_tool
    [ "$mode" = deploy ] || CHECK_DRIFT=false
    check_project "$project" || die "fix the project contract before deploying."

    local lines cu current candidate state
    lines="$(release_lines "$project" "$component" "$@")"
    cu="$(upper "$component")"

    if [ "$mode" = rollback ]; then
        # Only to a release this host has served: a rollback skips the dump and the
        # migrations, so it must never be a way to put a new image live.
        # The whole set of images (runtime and migrate) must be one earlier deploy.
        local wanted deployed
        wanted=" $(tr '\n' ' ' <<<"$lines")"
        wanted="${wanted% }"
        deployed="$(awk -v c="$component" '$2 == "deploy" && $3 == c { $1 = $2 = $3 = ""; sub(/^ +/, " "); print }' \
            "$(state_dir "$project")/history" 2>/dev/null || true)"
        grep -qxF -- "$wanted" <<<"$deployed" \
            || die "${lines#*=} was never deployed here as one release; deploy it instead of rolling back to it."
    fi

    state="$(state_dir "$project")"
    current="$(images_file "$project")"
    candidate="$(mktemp "$state/images.XXXXXX")"
    CLEANUP+=("$candidate")
    grep -vE "^IMAGE_${cu}(_MIGRATE)?=" "$current" > "$candidate" || true
    printf '%s\n' "$lines" >> "$candidate"

    ensure_images "$lines"

    if [ "$mode" = deploy ]; then
        backup_component "$project" "$component" predeploy || die "the pre-deploy dump failed; nothing was changed."

        local service
        for service in $(conf_get "$project" "$component" predeploy); do
            log "running $service."
            compose_with "$project" "$candidate" run --rm "$service" \
                || die "$service failed; the current release keeps serving."
        done
    fi

    if ! rollout "$project" "$component" "$candidate"; then
        if grep -qE "^IMAGE_${cu}=" "$current"; then
            log "the new release is not healthy; rolling back to the release before it."
            rollout "$project" "$component" "$current" || log "ROLLBACK FAILED: the component may be down."
            echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) failed $component $(tr '\n' ' ' <<<"$lines")" >> "$state/history"
            die "$mode of '$project/$component' failed and was rolled back."
        fi
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) failed $component $(tr '\n' ' ' <<<"$lines")" >> "$state/history"
        die "$mode of '$project/$component' failed; there is no earlier release to roll back to."
    fi

    mv "$candidate" "$current"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $mode $component $(tr '\n' ' ' <<<"$lines")" >> "$state/history"
    log "$mode of '$project/$component' is serving."
    # No edge reload here: it would publish every project's site file, and a deploy
    # key speaks for one component. Caddy finds the new containers by name; site
    # changes go live with `katap edge reload`.
}

cmd_deploy() {
    [ "$#" -ge 3 ] || die "usage: katap deploy <project> <component> <image@sha256:…> [migrate=<image@sha256:…>]"
    release deploy "$@"
}

cmd_rollback() {
    [ "$#" -ge 2 ] || die "usage: katap rollback <project> <component> [<image@sha256:…> [migrate=<image@sha256:…>]]"
    local project="$1" component="$2"
    shift 2
    require_component "$project" "$component"

    # env= (from ssh-dispatch) travels through to release; the rest name images.
    local passthrough=() images=() arg
    for arg in "$@"; do
        case "$arg" in env=*) passthrough+=("$arg") ;; *) images+=("$arg") ;; esac
    done
    set -- "${images[@]}"

    if [ "$#" -eq 0 ]; then
        # The release deployed before the one now serving. Only `deploy` entries
        # count: walking back from the newest deploy of the serving image, so a second
        # rollback goes further back instead of returning to what was rolled away from.
        local cu now line entry=() target=() found=false
        cu="$(upper "$component")"
        now="$(file_get "$(images_file "$project")" "IMAGE_$cu")"
        [ -n "$now" ] || die "'$project/$component' has no release serving."
        while IFS= read -r line; do
            read -ra entry <<<"$line"
            [ "${entry[1]:-}" = deploy ] && [ "${entry[2]:-}" = "$component" ] || continue
            if [ "$found" = false ]; then
                [ "${entry[3]#IMAGE_"$cu"=}" != "$now" ] || found=true
                continue
            fi
            [ "${entry[3]#IMAGE_"$cu"=}" != "$now" ] || continue
            target=("${entry[@]}")
            break
        done < <(tac "$(state_dir "$project")/history" 2>/dev/null || true)
        [ "${#target[@]}" -gt 0 ] || die "no earlier release of '$project/$component' to roll back to."

        set -- "${target[3]#IMAGE_"$cu"=}"
        [ "${#target[@]}" -lt 5 ] || set -- "$1" "migrate=${target[4]#IMAGE_"${cu}"_MIGRATE=}"
        log "rolling back to $1."
    fi

    release rollback "$project" "$component" "$@" "${passthrough[@]}"
}

# --- run / cron -----------------------------------------------------------------

cmd_run() {
    [ "$#" -ge 2 ] || die "usage: katap run <project> <service> [args...]"
    local project="$1" service="$2"
    shift 2
    require_project "$project"
    # Captured first: piped into `grep -q` under pipefail, compose dies of SIGPIPE
    # whenever the match is not its last line, and the lookup fails at random.
    local services
    services="$(compose "$project" --profile '*' config --services)"
    grep -qxF -- "$service" <<<"$services" || die "project '$project' has no service '$service'."
    if [ "${1:-}" = --no-deps-run ]; then
        shift
        compose "$project" run --rm --no-deps "$service" "$@"
        return
    fi
    compose "$project" run --rm "$service" "$@"
}

released() { grep -qE "^IMAGE_$(upper "$2")=" "$(images_file "$1")"; }

cron_project() {
    local project="$1" component service
    # Busy (the previous minute's run, a deploy, a restore, a backup): skip this
    # minute rather than pile up or run against a project being changed.
    try_lock_project "$project" || return 0
    for component in $(components_of "$project"); do
        released "$project" "$component" || continue
        for service in $(conf_get "$project" "$component" cron); do
            # --no-deps: a scheduler never starts, or recreates, the database it
            # depends on; if that is down, this minute fails and the next one retries.
            # Bounded below the 15 minutes a deploy waits for the project lock: work
            # longer than that belongs on the queue, not in the scheduler's foreground.
            timeout --kill-after=30s "${KATAP_CRON_TIMEOUT:-10m}" \
                "$KATAP_SELF" run "$project" "$service" --no-deps-run || log "$project/$service failed."
        done
    done
    exec 9>&-
}

cmd_cron() {
    local project
    if [ "${1:-}" = --all ]; then
        # One process per project, started and not waited for: a slow job in one
        # project must not hold back another's minute. katap-cron.service sets
        # KillMode=process so systemd leaves them running.
        for project in $(all_projects); do
            setsid "$KATAP_SELF" cron "$project" </dev/null &
        done
    else
        [ "$#" -eq 1 ] || die "usage: katap cron --all | <project>"
        require_project "$1"
        cron_project "$1"
    fi
}

# --- backup / restore -----------------------------------------------------------

# Dumps one component's database. Returns non-zero (with the reason logged) when a
# dump was due and could not be taken; the caller decides whether that is fatal.
# Beside every dump, <dump>.images records the release serving when it was taken,
# which is what `restore` puts back.
backup_component() {
    local project="$1" component="$2" reason="$3" keep="${4:-}" service dir file
    service="$(conf_get "$project" "$component" backup)"
    [ -n "$service" ] || return 0
    # Before a component's first release there is nothing to dump.
    [ "$reason" != predeploy ] || released "$project" "$component" || return 0
    if [ -z "$(compose "$project" ps -q --status running "$service" 2>/dev/null)" ]; then
        log "$project/$component: $service is not running; no dump was taken."
        return 1
    fi

    dir="$KATAP_SRV/backups/$project"
    mkdir -p "$dir"
    chmod 700 "$dir"
    file="$dir/$component-$(date -u +%Y%m%dT%H%M%SZ)-$reason.dump"

    log "dumping $project/$service to $file."
    # A dump waiting on a lock (a migration's ALTER TABLE) gives up instead of
    # stalling every query queued behind both.
    if ! (umask 077 && compose "$project" exec -T "$service" \
        pg_dump -U postgres -d app -Fc --lock-wait-timeout=300s > "$file.partial"); then
        rm -f "$file.partial"
        log "$project/$component: the database dump failed."
        return 1
    fi
    if [ ! -s "$file.partial" ]; then
        rm -f "$file.partial"
        log "$project/$component: the database dump is empty."
        return 1
    fi
    if ! (umask 077 && cp "$(images_file "$project")" "$file.images") || ! mv "$file.partial" "$file"; then
        rm -f "$file.partial" "$file.images"
        log "$project/$component: the dump could not be saved."
        return 1
    fi

    # Keep the newest KATAP_BACKUP_KEEP dumps of each kind, so a run of deploys never
    # rotates out the nightly ones. Names are <component>-<UTC time>-<reason>.dump
    # and sort by time.
    local dumps=()
    dumps=("$dir/$component-"*"-$reason.dump")
    while [ "${#dumps[@]}" -gt "$KATAP_BACKUP_KEEP" ]; do
        # Never the dump a restore is reading from.
        [ "$(readlink -f "${dumps[0]}")" = "$keep" ] || rm -f "${dumps[0]}" "${dumps[0]}.images"
        dumps=("${dumps[@]:1}")
    done

    if [ -n "${KATAP_RCLONE_REMOTE:-}" ]; then
        if ! command -v rclone >/dev/null || ! rclone copy "$file" "$KATAP_RCLONE_REMOTE/$project/" \
            || ! rclone copy "$file.images" "$KATAP_RCLONE_REMOTE/$project/"; then
            log "$project/$component: the off-host copy failed; $file is on this host only."
            # A deploy is not held hostage by the backup remote; the nightly run is.
            [ "$reason" = predeploy ] || return 1
        fi
    fi
}

cmd_backup() {
    local projects=() project component failed=0
    if [ "${1:-}" = --all ]; then
        mapfile -t projects < <(all_projects)
    else
        [ "$#" -eq 1 ] || die "usage: katap backup --all | <project>"
        require_project "$1"
        projects=("$1")
    fi
    # Every project is attempted whatever another one does; the exit status says
    # whether any failed.
    for project in "${projects[@]}"; do
        if ! (
            lock_project "$project" 1800
            status=0
            for component in $(components_of "$project"); do
                released "$project" "$component" || continue
                backup_component "$project" "$component" scheduled || status=1
            done
            exit "$status"
        ); then
            log "the backup of '$project' failed."
            failed=1
        fi
    done
    return "$failed"
}

# Restores one component's database from a dump, and the release that was serving
# when it was taken. The dump goes into a new database, swapped in only once it is
# complete: a failed restore leaves the current data untouched, and a successful one
# leaves nothing of the current schema behind.
cmd_restore() {
    [ "$#" -eq 5 ] && [ "$4" = --confirm ] || die "usage: katap restore <project> <component> <dump> --confirm <project>"
    local project="$1" component="$2" dump="$3"
    require_component "$project" "$component"
    [ "$5" = "$project" ] || die "--confirm must repeat the project name."
    [ -s "$dump" ] || die "no dump at $dump."
    [ -s "$dump.images" ] || die "no $dump.images: the release that wrote this dump is unknown."

    local service cu lines
    service="$(conf_get "$project" "$component" backup)"
    [ -n "$service" ] || die "component '$component' has no database."
    cu="$(upper "$component")"
    lines="$(grep -E "^IMAGE_${cu}(_MIGRATE)?=" "$dump.images" || true)"
    [ -n "$lines" ] || die "$dump.images has no release of '$component'."

    # Held open from here on, and kept out of the safety dump's pruning.
    exec 6<"$dump"
    dump="$(readlink -f "$dump")"

    lock_project "$project"
    [ -n "$(compose "$project" ps -q --status running "$service" 2>/dev/null)" ] || die "$service is not running."

    # Before anything is stopped: a release this host no longer has, and cannot
    # pull, refuses the restore with the data untouched.
    ensure_images "$lines"

    psql_admin() { compose "$project" exec -T "$service" psql -X -q -v ON_ERROR_STOP=1 -U postgres -d postgres "$@"; }
    local rollout_services current
    rollout_services="$(conf_get "$project" "$component" rollout)"
    current="$(images_file "$project")"

    # Stopped before the safety dump, so no write lands after it and is lost.
    # shellcheck disable=SC2086 # a list of service names
    compose "$project" stop $rollout_services || die "could not stop $rollout_services; nothing was changed."

    # Any failure until the swap leaves the data as it was: bring the services back.
    abandon() {
        psql_admin -c 'DROP DATABASE IF EXISTS app_restore WITH (FORCE)' >/dev/null 2>&1 || true
        rollout "$project" "$component" "$current" || log "the services did not come back; check them."
        die "$1; the database is unchanged."
    }
    backup_component "$project" "$component" prerestore "$dump" || abandon "the safety dump failed"
    psql_admin -c 'DROP DATABASE IF EXISTS app_restore WITH (FORCE)' >/dev/null || abandon "could not prepare the restore"
    psql_admin -v db=app_restore < "$KATAP_ROOT/lib/app-database.sql" >/dev/null || abandon "could not create the restore database"
    compose "$project" exec -T "$service" pg_restore -U postgres -d app_restore --single-transaction --exit-on-error <&6 \
        || abandon "the restore failed"
    psql_admin -c 'DROP DATABASE app WITH (FORCE)' -c 'ALTER DATABASE app_restore RENAME TO app' >/dev/null \
        || die "the swap failed: the restored data is in database app_restore; rename it to app by hand, then 'katap rollback'."

    # From here the data is the dump's, so the state records the dump's release
    # whatever happens next.
    local state candidate
    state="$(state_dir "$project")"
    candidate="$(mktemp "$state/images.XXXXXX")"
    CLEANUP+=("$candidate")
    grep -vE "^IMAGE_${cu}(_MIGRATE)?=" "$current" > "$candidate" || true
    printf '%s\n' "$lines" >> "$candidate"
    mv "$candidate" "$current"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) restore $component $(tr '\n' ' ' <<<"$lines")from $(basename "$dump")" >> "$state/history"

    # Queued jobs and cached state (permissions, sessions) describe the data that was
    # just replaced. Cleared before anything starts, so no worker runs a job for a row
    # that no longer exists.
    if grep -qxF -- "$component-redis" <<<"$(compose "$project" --profile '*' config --services)"; then
        compose "$project" exec -T "$component-redis" redis-cli FLUSHALL >/dev/null \
            || log "WARNING: could not clear $component-redis; clear queued jobs and caches by hand."
    fi

    rollout "$project" "$component" "$current" \
        || die "the data is restored, but its release did not become healthy; check the services."
    log "restored '$project/$component' from $(basename "$dump"), with the release that wrote it."
}

# --- apply ----------------------------------------------------------------------

# Whether <site.caddy> has a site block for <domain>: the name in a block's
# address list, not inside a directive.
site_serves() {
    [ -f "$1" ] && grep -qE "^([^[:space:]#{][^{]*[ ,])?([a-z]+://)?${2//./\\.}(:[0-9]+)?([ ,]|\{|$)" "$1"
}

# The .conf keys katap.json owns. apply writes them; every other key, the compose
# file, site.caddy and the secrets stay the operator's after the first apply.
JSON_KEYS=(image image_migrate environment domains)

# Reads $KATAP_PROJECTS_FILE (or the file given) into WANTED[<project>/<component>/<key>] (type and the
# JSON_KEYS), WANTED_LIST (<project>/<component>, in file order) and WANTED_HOST.
# Every value is validated before anything uses it: these values become lines of
# a .conf, read first-match by file_get, so one stray newline would be a second
# setting. Dies naming the first problem.
declare -A WANTED=()
WANTED_LIST=()
WANTED_HOST=''
WANTED_LOADED=false
load_projects_file() {
    [ "$WANTED_LOADED" = false ] || return 0
    local file="${1:-$KATAP_PROJECTS_FILE}" rows
    [ -f "$file" ] || die "no $file; write it first (docs/projects-file.md)."
    rows="$(jq -r '
        def fail($m): "error\u001f\($m)";
        def allowed: ["type", "repo", "domains", "environment", "image"];
        if type != "object" then fail("the file must be one JSON object")
        elif ((keys - ["host", "projects"]) | length) > 0 then fail("unknown key(s) \((keys - ["host", "projects"]) | join(", ")); expected host and projects")
        elif ([.. | strings, (objects | keys[]) | select(test("[[:space:][:cntrl:]]"))] | length) > 0 then fail("a name or value contains whitespace or a control character")
        elif ((.host // "") | type) != "string" then fail("host must be a string")
        elif ((.projects // {}) | type) != "object" then fail("projects must be an object of projects")
        else
            "host\u001f\(.host // "")",
            ((.projects // {}) | to_entries[] | .key as $p |
                if (.value | type) != "object" then fail("project \($p) must be an object of components")
                else .value | to_entries[] | .key as $c | .value as $v |
                    if ($v | type) != "object" then fail("\($p)/\($c) must be an object")
                    elif ($v | has("provenance")) then fail("\($p)/\($c): provenance is no longer a setting (Katap v2 checks no attestations); remove it")
                    elif ((($v | keys) - allowed) | length) > 0 then fail("\($p)/\($c): unknown key(s) \((($v | keys) - allowed) | join(", "))")
                    elif ([$v.type, $v.repo] | any(type != "string")) then fail("\($p)/\($c): type and repo are required")
                    elif ([$v.environment, $v.image] | any(. != null and type != "string")) then fail("\($p)/\($c): environment and image are strings")
                    elif (($v.domains // []) | (type != "array") or any(.[]; type != "string")) then fail("\($p)/\($c): domains must be a list of names")
                    elif ([($v.domains // [])[] | select(test($domain_re) | not)] | length) > 0 then fail("\($p)/\($c): invalid domain '"'"'\([($v.domains // [])[] | select(test($domain_re) | not)][0])'"'"'")
                    else ["component", $p, $c, $v.type, $v.repo, ($v.image // ""), ($v.environment // "production"), (($v.domains // []) | join(" "))] | join("\u001f")
                    end
                end)
        end' --arg domain_re "$DOMAIN_RE" "$file" 2>&1)" || die "$file is not valid JSON: $rows"

    local kind project component type repo image environment domains d id list
    declare -A owner=() binding=()
    # The unit separator, not a tab: empty fields (no image, no domains) must not
    # collapse into each other, as runs of whitespace separators do.
    while IFS=$'\x1f' read -r kind project component type repo image environment domains; do
        case "$kind" in
            error) die "$file: $project" ;;
            host)
                WANTED_HOST="$project"
                [ -z "$WANTED_HOST" ] || [[ "$WANTED_HOST" =~ $IPV4_RE ]] || die "$file: host must be this server's public IPv4 address."
                continue
                ;;
        esac
        id="$project/$component"
        [[ "$project" =~ $PROJECT_RE ]] || die "$file: invalid project name '$project' (expected ${PROJECT_RE})."
        [[ "$component" =~ $COMPONENT_RE ]] || die "$file: $project: invalid component name '$component' (expected ${COMPONENT_RE})."
        if ! [[ "$type" =~ ^[a-z][a-z0-9-]*$ ]] || [ ! -f "$KATAP_ROOT/templates/$type.yml" ] || [ ! -f "$KATAP_ROOT/templates/$type.conf" ]; then
            local known=() template
            for template in "$KATAP_ROOT"/templates/*.yml; do known+=("$(basename "$template" .yml)"); done
            die "$file: $id: unknown type '$type' (expected one of: ${known[*]})."
        fi
        [[ "$repo" =~ $REPO_RE ]] || die "$file: $id: repo must be owner/name."
        [ -n "$image" ] || image="ghcr.io/$(tr '[:upper:]' '[:lower:]' <<<"$repo")"
        [[ "$image" =~ $IMAGE_RE ]] || die "$file: $id: image must be a lowercase repository without a tag or digest."
        case "$environment" in production|staging) ;; *) die "$file: $id: environment must be production or staging." ;; esac
        # Split without globbing: a pattern such as *.example.com must reach the
        # check, not expand to nothing (nullglob) and skip it.
        read -ra list <<<"$domains"
        for d in "${list[@]}"; do
            [[ "$d" =~ $DOMAIN_RE ]] || die "$file: $id: invalid domain '$d'."
            [ -z "${owner[$d]+set}" ] || die "$file: $d is claimed by both ${owner[$d]} and $id."
            owner[$d]="$id"
        done
        [ -z "${WANTED[$id/type]+set}" ] || die "$file: $id appears twice."
        # A repository's secrets hold one deploy key per environment: two components
        # of one repository in one environment would need the same secret names.
        d="$(tr '[:upper:]' '[:lower:]' <<<"$repo")/$environment"
        [ -z "${binding[$d]+set}" ] || die "$file: ${binding[$d]} and $id are both $repo in $environment; a repository deploys one component per environment."
        binding[$d]="$id"
        if [ -f "$(conf_file "$project" "$component")" ] && [ "$(conf_get "$project" "$component" type)" != "$type" ]; then
            die "$file: $id is a $(conf_get "$project" "$component" type) component; it says $type. A component never changes type."
        fi
        WANTED_LIST+=("$id")
        WANTED[$id/type]="$type"
        WANTED[$id/image]="$image"
        WANTED[$id/image_migrate]=''
        ! grep -q '^image_migrate=' "$KATAP_ROOT/templates/$type.conf" || WANTED[$id/image_migrate]="$image-migrate"
        WANTED[$id/environment]="$environment"
        WANTED[$id/domains]="$domains"
    done <<<"$rows"

    # A domain another component serves now, by its .conf or by a block in a
    # site.caddy, is still served after this apply: site.caddy is never rewritten,
    # and two site blocks for one name stop the edge. Moving a domain takes two
    # applies, with site.caddy edited in between.
    local p c
    for p in $(all_projects); do
        for c in $(components_of "$p"); do
            read -ra list <<<"$(conf_get "$p" "$c" domains)"
            for d in "${list[@]}"; do
                [ -z "${owner[$d]+set}" ] || [ "${owner[$d]}" = "$p/$c" ] \
                    || die "$file: ${owner[$d]} claims $d, which $p/$c still serves; remove it from $p/$c (and its site.caddy block) first."
            done
        done
        for d in "${!owner[@]}"; do
            [ -f "$(conf_file "${owner[$d]%%/*}" "${owner[$d]#*/}")" ] && [ "${owner[$d]%%/*}" = "$p" ] && continue
            ! site_serves "$(project_dir "$p")/site.caddy" "$d" \
                || die "$file: ${owner[$d]} claims $d, which $(project_dir "$p")/site.caddy already serves; remove that block first."
        done
    done
    WANTED_LOADED=true
}

# Sets <key>=<value> lines in a .conf: the first line for each key is replaced in
# place, later ones dropped, a missing one appended. Written to a temporary file
# and renamed, so a deploy reading the .conf never sees half of it.
set_conf_keys() {
    local file="$1" tmp
    shift
    tmp="$(mktemp "$file.XXXXXX")"
    CLEANUP+=("$tmp")
    KATAP_SET="$(printf '%s\n' "$@")" awk '
        BEGIN { n = split(ENVIRON["KATAP_SET"], pairs, "\n"); for (i = 1; i <= n; i++) if (pairs[i] != "") { k = pairs[i]; sub(/=.*/, "", k); want[k] = pairs[i]; order[++count] = k } }
        { k = $0; sub(/=.*/, "", k) }
        $0 ~ /^[a-z_]+=/ && (k in want) { if (!(k in done)) { print want[k]; done[k] = 1 }; next }
        { print }
        END { for (i = 1; i <= count; i++) if (!(order[i] in done)) print want[order[i]] }
    ' "$file" > "$tmp"
    chmod --reference="$file" "$tmp" 2>/dev/null || true
    mv "$tmp" "$file"
}

# Everything apply creates, and the deploy keys deploy-key and remove write, must
# belong to whoever runs deploys, cron and backups: run as root, apply would leave
# a project the deploy user cannot open, and a key would land in root's
# authorized_keys.
require_owner() {
    [ -d "$KATAP_PROJECTS" ] && [ -O "$KATAP_PROJECTS" ] \
        || die "run $1 as the owner of $KATAP_PROJECTS: katap $1 (or sudo -u deploy $KATAP_ROOT/bin/katap $1)"
}

cmd_apply() {
    local yes=false
    case "${1:-}" in
        --yes) yes=true; shift ;;
    esac
    [ "$#" -eq 0 ] || die "usage: katap apply [--yes]   (reads $KATAP_PROJECTS_FILE)"
    require_owner apply
    load_projects_file

    local id project component key created=() updated=() drift=() pairs list umask_before

    # What this run will create or change, shown before anything is written: a
    # typo in a project name is caught here, not after it became a directory.
    local plan=()
    for id in "${WANTED_LIST[@]}"; do
        project="${id%%/*}"
        component="${id#*/}"
        if [ ! -f "$(conf_file "$project" "$component")" ]; then
            plan+=("create $id (${WANTED[$id/type]})${WANTED[$id/domains]:+, serving ${WANTED[$id/domains]}}")
            continue
        fi
        pairs=()
        for key in "${JSON_KEYS[@]}"; do
            [ "$(conf_get "$project" "$component" "$key")" = "${WANTED[$id/$key]}" ] || pairs+=("$key")
        done
        [ "${#pairs[@]}" -eq 0 ] || plan+=("update $id: ${pairs[*]}")
    done
    if [ "${#plan[@]}" -gt 0 ]; then
        echo "katap apply will:"
        printf '  %s\n' "${plan[@]}"
        if [ "$yes" = false ]; then
            local answer=''
            { printf 'Continue? [y/N] ' > /dev/tty && IFS= read -r answer < /dev/tty; } 2>/dev/null \
                || die "no terminal to confirm on; nothing was changed. Run: katap apply --yes"
            case "$answer" in y|Y|yes|YES) ;; *) die "nothing was changed." ;; esac
        fi
    fi
    declare -A new_component=()
    local projects=() seen=' '
    for id in "${WANTED_LIST[@]}"; do
        project="${id%%/*}"
        [[ "$seen" == *" $project "* ]] || { projects+=("$project"); seen+="$project "; }
    done

    for project in "${projects[@]}"; do
        mkdir -p "$(project_dir "$project")"
        lock_project "$project"
        # Every component first, then the secrets: a frontend added in the same
        # run is known to the API's secrets.
        for id in "${WANTED_LIST[@]}"; do
            [ "${id%%/*}" = "$project" ] || continue
            component="${id#*/}"
            if [ ! -f "$(conf_file "$project" "$component")" ]; then
                [ ! -e "$(project_dir "$project")/$component.yml" ] \
                    || die "$id is half-created ($(project_dir "$project")/$component.yml without its .conf); remove that file and any '# $component' block in site.caddy, then run apply again."
                read -ra list <<<"${WANTED[$id/domains]}"
                cmd_add "$project" "${WANTED[$id/type]}" "$component" "${list[@]}" >/dev/null
                new_component[$id]=1
                created+=("$id (${WANTED[$id/type]})")
            fi
            local before
            before="$(conf_get "$project" "$component" domains)"
            pairs=()
            for key in "${JSON_KEYS[@]}"; do
                [ "$(conf_get "$project" "$component" "$key")" = "${WANTED[$id/$key]}" ] || pairs+=("$key=${WANTED[$id/$key]}")
            done
            if [ "${#pairs[@]}" -gt 0 ]; then
                set_conf_keys "$(conf_file "$project" "$component")" "${pairs[@]}"
                [ -n "${new_component[$id]+set}" ] || updated+=("$id: ${pairs[*]%%=*}")
            fi
            # Katap v1's keys, which no longer mean anything: left in place, a
            # .conf would still claim the server checks attestations.
            local conf
            conf="$(conf_file "$project" "$component")"
            if grep -qE '^(source_repo|provenance)=' "$conf"; then
                local status=0
                grep -vE '^(source_repo|provenance)=' "$conf" > "$conf.v1" || status=$?
                [ "$status" -le 1 ] || die "could not read $conf; it is unchanged."
                chmod --reference="$conf" "$conf.v1" 2>/dev/null || true
                mv "$conf.v1" "$conf"
                updated+=("$id: removed v1's source_repo and provenance")
            fi
            if [ -z "${new_component[$id]+set}" ] && [ "$before" != "${WANTED[$id/domains]}" ]; then
                drift+=("$id: its domains changed; edit $(project_dir "$project")/site.caddy to match, then run 'katap edge reload'. Values generated from the old domain (APP_URL, API_BASE_URL) stay as they are in $(secrets_dir "$project")/$component.env.")
            fi
        done
        for id in "${WANTED_LIST[@]}"; do
            [ "${id%%/*}" = "$project" ] || continue
            component="${id#*/}"
            if [ ! -e "$(secrets_dir "$project")/$component.env" ]; then
                local partial=() f
                for f in "$component.db.env" "$component.redis.env" "$component-db-tls"; do
                    [ ! -e "$(secrets_dir "$project")/$f" ] || partial+=("$(secrets_dir "$project")/$f")
                done
                [ "${#partial[@]}" -eq 0 ] \
                    || die "$id's secrets are half-made (${partial[*]} without $component.env); nothing in them was used yet: remove them, then run apply again."
                # secrets sets a strict umask for its own files; the next project's
                # directories and files get the usual modes.
                umask_before="$(umask)"
                cmd_secrets "$project" "$component" >/dev/null
                umask "$umask_before"
            fi
        done
        exec 9>&-
    done

    # Every time, not only when something was created: a run that stopped after
    # writing a site block must not leave it unloaded once the next run has
    # nothing left to create. A no-op while the edge is down; validated first.
    edge_reload || die "the edge rejected the sites; the previous configuration keeps serving. Fix site.caddy and run 'katap edge reload'."
    apply_report
}

# What is left for the operator after apply: the A records, the values only they
# know, what apply did not touch, and the commands that come next. All of it is
# printed from validated values.
apply_report() {
    local id project component d missing spec key generator want have list
    [ "${#created[@]}" -eq 0 ] || { echo "Created:"; printf '  %s\n' "${created[@]}"; }
    [ "${#updated[@]}" -eq 0 ] || { echo "Updated in .conf:"; printf '  %s\n' "${updated[@]}"; }

    echo "DNS (an A record each, no AAAA: the edge is IPv4 only):"
    for id in "${WANTED_LIST[@]}"; do
        read -ra list <<<"${WANTED[$id/domains]}"
        for d in "${list[@]}"; do
            printf '  %-40s A  %s\n' "$d" "${WANTED_HOST:-<set host in $KATAP_PROJECTS_FILE>}"
        done
    done

    local todo=()
    for id in "${WANTED_LIST[@]}"; do
        project="${id%%/*}"
        component="${id#*/}"
        missing="$(empty_required "$project" "$component" | tr '\n' ' ')"
        [ -z "$missing" ] || todo+=("$(secrets_dir "$project")/$component.env: $missing")
        # A value derived from the frontend when the secrets were made, which the
        # project's frontend no longer gives: reported, never rewritten.
        spec="$KATAP_ROOT/templates/${WANTED[$id/type]}.env.spec"
        while IFS='=' read -r key generator; do
            case "$generator" in frontend:url|frontend:origins) ;; *) continue ;; esac
            want="$(frontend_of "$project" "$component" "${generator#frontend:}")"
            have="$(file_get "$(secrets_dir "$project")/$component.env" "$key")"
            [ -z "$want" ] || [ -z "$have" ] || [ "$want" = "$have" ] \
                || drift+=("$id: $key is $have in $component.env; the project's frontend now gives $want.")
        done < <(grep -E '^[A-Z][A-Z0-9_]*=' "$spec")
    done
    if [ "${#todo[@]}" -gt 0 ]; then
        echo "Fill in (deploys are refused while these are empty):"
        printf '  %s\n' "${todo[@]}"
    fi
    [ "${#drift[@]}" -eq 0 ] || { echo "Check by hand:"; printf '  %s\n' "${drift[@]}"; }

    local unmanaged=() p c
    for p in $(all_projects); do
        for c in $(components_of "$p"); do
            [ -n "${WANTED[$p/$c/type]+set}" ] || unmanaged+=("$p/$c")
        done
    done
    if [ "${#unmanaged[@]}" -gt 0 ]; then
        echo "Not in $KATAP_PROJECTS_FILE (left as they are; apply never removes anything):"
        printf '  %s\n' "${unmanaged[@]}"
        echo "  One that was never deployed is removed with: katap remove <project> <component> --confirm <project>"
    fi

    echo "Next, for each component:"
    echo "  katap env <project> <component>          fill in its settings"
    echo "  katap deploy-key <project> <component>   its deploy key, and the secrets to add to its GitHub repository"
}

# --- env, deploy-key, remove ---------------------------------------------------

# Opens a component's settings in an editor, then names what is still empty.
cmd_env() {
    [ "$#" -eq 2 ] || die "usage: katap env <project> <component>"
    require_component "$1" "$2"
    local file missing
    file="$(secrets_dir "$1")/$2.env"
    [ -f "$file" ] || die "no $file yet; run katap apply first."
    "${VISUAL:-${EDITOR:-nano}}" "$file"
    missing="$(empty_required "$1" "$2" | tr '\n' ' ')"
    if [ -n "$missing" ]; then
        echo "Still empty (deploys are refused until they are set): $missing"
    else
        echo "Every required value is set. A change reaches the running application on its next deploy."
    fi
}

# The forced command that binds a deploy key to one component of one project in
# one environment. The binding lives here, on the server, never in a request.
key_binding() { printf 'restrict,command="%s/bin/katap ssh-dispatch %s %s %s"' "$KATAP_ROOT" "$1" "$2" "$3"; }

# Matches the authorized_keys line of <environment> <project> <component>'s key,
# whichever tool path wrote it. Names are [a-z0-9-], so they are regex-safe.
key_pattern() { printf 'ssh-dispatch %s %s %s" ' "$1" "$2" "$3"; }

# Rewrites the deploy user's authorized_keys under a lock: every line matching
# <drop> (an extended regex) removed, then <add> appended when given. Built in the
# file's own directory and renamed, so sshd never reads half of it; a read error
# changes nothing.
rewrite_authorized_keys() {
    local drop="$1" add="${2:-}" file="$KATAP_AUTHORIZED_KEYS" dir tmp lock status=0
    dir="$(dirname "$file")"
    mkdir -p "$dir"
    chmod 700 "$dir"
    [ -f "$file" ] || (umask 077 && : > "$file")
    exec {lock}>"$dir/.katap-keys.lock"
    flock -w 60 "$lock" || die "another katap command is changing $file; nothing was changed."
    tmp="$(mktemp "$dir/.authorized_keys.XXXXXX")"
    CLEANUP+=("$tmp")
    grep -vE -- "$drop" "$file" > "$tmp" || status=$?
    [ "$status" -le 1 ] || die "could not read $file; nothing was changed."
    [ -z "$add" ] || printf '%s\n' "$add" >> "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$file"
    exec {lock}>&-
}

# Makes a component's deploy key: authorises its public half for deploys of this
# component only, and prints the private half once, with the other values the
# repository's workflow needs. Nothing of the private key stays on this host.
cmd_deploy_key() {
    local replace=false args=() arg
    for arg in "$@"; do
        case "$arg" in
            --replace) replace=true ;;
            *) args+=("$arg") ;;
        esac
    done
    [ "${#args[@]}" -eq 2 ] || die "usage: katap deploy-key <project> <component> [--replace]"
    local project="${args[0]}" component="${args[1]}"
    require_owner deploy-key
    require_component "$project" "$component"
    load_projects_file
    [ -n "$WANTED_HOST" ] || die "set host (this server's public IPv4 address) in $KATAP_PROJECTS_FILE first."

    local environment hostkey binding file
    environment="$(conf_get "$project" "$component" environment)"
    case "$environment" in
        production|staging) ;;
        *) die "$(conf_file "$project" "$component"): environment= must be production or staging." ;;
    esac
    hostkey="$(cut -d' ' -f1-2 "$KATAP_HOST_KEY_FILE" 2>/dev/null || true)"
    [[ "$hostkey" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+=*$ ]] || die "could not read this server's ed25519 host key ($KATAP_HOST_KEY_FILE)."
    binding="$(key_binding "$environment" "$project" "$component")"
    file="$KATAP_AUTHORIZED_KEYS"

    if grep -qE "$(key_pattern "$environment" "$project" "$component")" "$file" 2>/dev/null && [ "$replace" = false ]; then
        die "$project/$component already has a $environment deploy key. To replace it (the old one stops working at once): katap deploy-key $project $component --replace"
    fi

    local work
    work="$(mktemp -d)"
    CLEANUP+=("$work")
    chmod 700 "$work"
    ssh-keygen -q -t ed25519 -N '' -C "katap $project/$component $environment" -f "$work/key"
    rewrite_authorized_keys "$(key_pattern "$environment" "$project" "$component")" "$binding $(cat "$work/key.pub")"
    # A v1 key bound to several components also deploys this one; it is the
    # operator's to remove, since it still speaks for the others.
    if grep -qE "ssh-dispatch $environment $project ([a-z0-9-]+,)*$component(,[a-z0-9-]+)+\"|ssh-dispatch $environment $project ([a-z0-9-]+,)+$component\"" "$file"; then
        echo "Note: an older key in $file is bound to $project/$component together with other"
        echo "components (ssh-dispatch $environment $project <a>,<b>). It still deploys this one; remove that line once"
        echo "each of those components has its own key."
        echo
    fi

    local prefix=KATAP_ release='' url='' domains
    [ "$environment" = production ] || prefix=KATAP_STAGING_
    if [ -f "$KATAP_RELEASE_FILE" ]; then
        release="$(file_get "$KATAP_RELEASE_FILE" commit) # $(file_get "$KATAP_RELEASE_FILE" tag)"
    fi
    domains="$(conf_get "$project" "$component" domains)"
    # A wildcard names no host to check.
    [ -z "$domains" ] || [[ "$domains" == \** ]] || url="https://${domains%% *}$(conf_get "$project" "$component" smoke_path)"

    cat <<EOF
A $environment deploy key for $project/$component is authorised on this server. It
can deploy and roll back $project/$component and nothing else.

Add these as repository secrets in GitHub: open the repository, then
Settings → Secrets and variables → Actions → New repository secret.

${prefix}SSH_KEY   (every line, including the BEGIN and END lines)
$(cat "$work/key")

${prefix}HOST
$WANTED_HOST

${prefix}KNOWN_HOSTS
$WANTED_HOST $hostkey

The private key above is shown once and is not kept on this server. Clear
your terminal once it is saved in GitHub.

Then add this step to the repository's workflow, in a job after the one that
builds and pushes the image, with permissions: packages: read (see
docs/deploying.md and examples/github-workflow.yml):

      - uses: jaylordibe/katap@${release:-<commit of the Katap release this server runs>}
        with:
          host: \${{ secrets.${prefix}HOST }}
          known-hosts: \${{ secrets.${prefix}KNOWN_HOSTS }}
          ssh-key: \${{ secrets.${prefix}SSH_KEY }}
          project: $project
          component: $component
          image: \${{ needs.build.outputs.image }}
EOF
    [ -z "$(conf_get "$project" "$component" image_migrate)" ] \
        || echo "          migrate-image: \${{ needs.build.outputs.migrate-image }}"
    [ -z "$url" ] || echo "          url: $url"
}

# Removes components that were never deployed: a typo in katap.json, or one
# created by mistake. Anything that ever served, or holds data, is refused:
# removing those is deliberate work for a person, never for this command.
# Removes <component>'s site block from <site> when it is exactly the block apply
# wrote; a block edited since is left in place, with a note, rather than guessed at.
remove_site_block() {
    local project="$1" component="$2" site="$3" type domains port block content
    [ -f "$site" ] || return 0
    type="$(conf_get "$project" "$component" type)"
    domains="$(conf_get "$project" "$component" domains)"
    if [ -z "$domains" ] || [ ! -f "$KATAP_ROOT/templates/$type.site" ]; then
        ! grep -q "^# $component (" "$site" || echo "Note: $site still has a block for $project/$component; remove it by hand."
        return 0
    fi
    port="$(file_get "$KATAP_ROOT/templates/$type.conf" port)"
    domains="${domains// /, }"
    block="$(sed -e "s/__C__/$component/g" -e "s/__DOMAINS__/$domains/" \
        -e "s/__UPSTREAM__/$project-$component:$port/" "$KATAP_ROOT/templates/$type.site")"
    content="$(cat "$site")"
    if [[ "$content" == *"$block"* ]]; then
        content="${content/"$block"/}"
        # Drop the blank lines the removal leaves at either end.
        content="$(printf '%s\n' "$content" | sed -e '/./,$!d' | tac | sed -e '/./,$!d' | tac)"
        printf '%s' "$content${content:+$'\n'}" > "$site"
    else
        echo "Note: $project/$component's block in $site was edited after apply wrote it; remove it by hand."
    fi
}

cmd_remove() {
    local args=() confirm=''
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --confirm)
                confirm="${2:-}"
                if [ "$#" -ge 2 ]; then shift 2; else shift; fi
                ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -ge 1 ] && [ "${#args[@]}" -le 2 ] && [ -n "$confirm" ] \
        || die "usage: katap remove <project> [<component>] --confirm <project>"
    local project="${args[0]}" components=() component
    require_owner remove
    require_project "$project"
    [ "$confirm" = "$project" ] || die "--confirm must repeat the project name."
    if [ "${#args[@]}" -eq 2 ]; then
        require_component "$project" "${args[1]}"
        components=("${args[1]}")
    else
        mapfile -t components < <(components_of "$project")
    fi

    [ ! -f "$KATAP_PROJECTS_FILE" ] || load_projects_file
    lock_project "$project"
    local state history containers volumes
    state="$(state_dir "$project")"
    history="$state/history"
    # Docker not answering is a refusal: an empty list must mean nothing ran.
    containers="$("$KATAP_DOCKER" ps -a --filter "label=com.docker.compose.project=$project" --format '{{.Label "com.docker.compose.service"}}')" \
        || die "could not list $project's containers; nothing was removed."
    volumes="$("$KATAP_DOCKER" volume ls --filter "label=com.docker.compose.project=$project" --format '{{.Label "com.docker.compose.volume"}}')" \
        || die "could not list $project's volumes; nothing was removed."
    for component in "${components[@]}"; do
        [ -z "${WANTED[$project/$component/type]+set}" ] \
            || die "$project/$component is in $KATAP_PROJECTS_FILE; remove it there first, or the next apply creates it again."
        ! released "$project" "$component" || die "$project/$component has a release serving; it was deployed, so this command will not remove it."
        ! awk -v c="$component" '$3 == c { found = 1 } END { exit !found }' "$history" 2>/dev/null \
            || die "$project/$component has been deployed, or a deploy was attempted (see $history); this command will not remove it."
        ! grep -qE "^$component(-[a-z0-9-]+)?$" <<<"$containers" || die "$project/$component has containers; this command removes only what never ran."
        ! grep -qE "^$component(-[a-z0-9-]+)?$" <<<"$volumes" || die "$project/$component has data volumes; this command never removes data."
    done

    # Removing the last component removes the project's directories whole, so
    # nothing in them may belong to anything else: a component whose files were
    # deleted by hand still has its secrets, history and volumes there.
    local left removing=" ${components[*]} "
    left="$(components_of "$project" | grep -vxF -f <(printf '%s\n' "${components[@]}") || true)"
    if [ -z "$left" ]; then
        [ -z "$containers$volumes" ] || die "$project still has containers or volumes ($(tr '\n' ' ' <<<"$containers$volumes")); this command never removes data."
        [ ! -s "$history" ] || die "$project has deployed before (see $history); this command will not remove it."
        local f name
        for f in "$state"/images.* "$(secrets_dir "$project")"/*; do
            case "$f" in
                "$state"/*) [ ! -s "$f" ] || die "$project has release state ($f); this command will not remove it."; continue ;;
            esac
            name="$(basename "$f")"
            name="${name%%.*}"
            name="${name%-db-tls}"
            [[ "$removing" == *" $name "* ]] || die "$project has secrets of a component that is not being removed ($f); this command will not remove them."
        done
    fi

    local dir secrets site
    dir="$(project_dir "$project")"
    secrets="$(secrets_dir "$project")"
    site="$dir/site.caddy"
    for component in "${components[@]}"; do
        remove_site_block "$project" "$component" "$site"
        rm -f -- "${dir:?}/${component:?}.yml" "${dir:?}/${component:?}.conf" \
            "${secrets:?}/${component:?}.env" "${secrets:?}/${component:?}.db.env" "${secrets:?}/${component:?}.redis.env"
        rm -rf -- "${secrets:?}/${component:?}-db-tls"
        if [ -f "$KATAP_AUTHORIZED_KEYS" ]; then
            rewrite_authorized_keys "$(key_pattern '(production|staging)' "$project" "$component")"
            ! grep -qE "ssh-dispatch [a-z]+ $project ([a-z0-9-]+,)*$component(,[a-z0-9-]+)*\"" "$KATAP_AUTHORIZED_KEYS" \
                || echo "Note: an older key in $KATAP_AUTHORIZED_KEYS is bound to $project/$component together with other components; remove that line by hand."
        fi
        log "removed $project/$component."
    done
    if [ -z "$left" ]; then
        rm -rf -- "${KATAP_PROJECTS:?}/${project:?}" "${KATAP_SRV:?}/secrets/${project:?}" \
            "${KATAP_SRV:?}/state/${project:?}" "${KATAP_SRV:?}/state/.dispatch/${project:?}"
        rmdir "${KATAP_SRV:?}/backups/${project:?}" 2>/dev/null || true
        log "removed project $project."
    fi
    exec 9>&-
    edge_reload || die "the edge rejected the remaining sites; the previous configuration keeps serving."
}

# --- images ---------------------------------------------------------------------

# The image repositories <project>... name, one per line.
repo_names() {
    local p c
    for p in "$@"; do
        for c in $(components_of "$p"); do
            conf_get "$p" "$c" image; echo
            conf_get "$p" "$c" image_migrate; echo
        done
    done | sed '/^$/d' | sort -u
}

# Removes images of Katap's components that no release needs any more. Kept: what
# serves now, a deploy in progress, the last $KATAP_RELEASES_KEPT deploys of each
# component (rollback targets), and every release a kept database dump records
# (restore targets). Each project is locked without waiting: a busy one is
# skipped, and every image of its repositories kept, so housekeeping never holds
# up a deploy or a scheduled job. Images of anything else on the host are left
# alone; dangling layers are pruned.
cmd_images() {
    [ "${1:-}" = prune ] && [ "$#" -eq 1 ] || die "usage: katap images prune"
    [[ "$KATAP_RELEASES_KEPT" =~ ^[0-9]{1,4}$ ]] && [ "$KATAP_RELEASES_KEPT" -ge 1 ] \
        || die "KATAP_RELEASES_KEPT must be a whole number of at least 1 (it is '$KATAP_RELEASES_KEPT')."
    local project projects=() locked=() busy=() fds=() fd
    mapfile -t projects < <(all_projects)
    for project in "${projects[@]}"; do
        ensure_state "$project"
        exec {fd}>"$(state_dir "$project")/.lock"
        if flock -n "$fd"; then
            fds+=("$fd")
            locked+=("$project")
        else
            exec {fd}>&-
            busy+=("$project")
            log "$project is busy; its images are kept this time."
        fi
    done

    # Every repository named by any project, and the ones a busy project names:
    # an image of those is never removed this run.
    local keep repos busy_repos component f line removed=0
    repos="$(repo_names "${projects[@]}")"
    busy_repos="$(repo_names "${busy[@]}")"
    keep="$(
        for project in "${locked[@]}"; do
            cat "$(state_dir "$project")"/images.* 2>/dev/null || true
            for component in $(components_of "$project"); do
                awk -v c="$component" '$2 == "deploy" && $3 == c { $1 = $2 = $3 = ""; print }' \
                    "$(state_dir "$project")/history" 2>/dev/null | tail -n "$KATAP_RELEASES_KEPT" | tr ' ' '\n'
            done
            for f in "$KATAP_SRV/backups/$project"/*.dump.images; do [ ! -f "$f" ] || cat "$f"; done
        done | sed -n 's/^IMAGE_[A-Z0-9_]*=//p' | sort -u
    )"
    while IFS= read -r line; do
        [ -n "$line" ] && [ "${line##*@}" != '<none>' ] || continue
        grep -qxF -- "${line%@*}" <<<"$repos" || continue
        ! grep -qxF -- "${line%@*}" <<<"$busy_repos" || continue
        ! grep -qxF -- "$line" <<<"$keep" || continue
        if "$KATAP_DOCKER" image rm "$line" >/dev/null 2>&1; then removed=$((removed + 1)); fi
    done < <("$KATAP_DOCKER" image ls --digests --format '{{.Repository}}@{{.Digest}}' 2>/dev/null || true)
    "$KATAP_DOCKER" image prune --force >/dev/null 2>&1 || true
    for fd in "${fds[@]}"; do exec {fd}>&-; done
    log "removed $removed image(s) no release needs."
}

# --- ssh-dispatch ---------------------------------------------------------------

# The forced command of an application's deploy key:
#   restrict,command="/srv/katap/bin/katap ssh-dispatch <environment> <project> <component>[,...]"
# It admits exactly `deploy` and `rollback` of those components; every argument is
# validated again by them. `katap deploy-key` writes that line.
cmd_ssh_dispatch() {
    # The binding comes from the key's forced command, never from the request.
    local environment="${1:-}" bound_project="${2:-}" bound_components="${3:-}"
    case "$environment" in
        production|staging) ;;
        *) die "refused: this key has no environment (authorized_keys: command=\"…/katap ssh-dispatch <production|staging> <project> <component>\")." ;;
    esac
    [[ "$bound_project" =~ $PROJECT_RE ]] && [[ "$bound_components" =~ ^[a-z][a-z0-9]{0,19}(,[a-z][a-z0-9]{0,19})*$ ]] \
        || die "refused: this key names no project and component; make a new one with: katap deploy-key <project> <component> --replace"

    local request="${SSH_ORIGINAL_COMMAND:-}"
    [[ "$request" =~ ^[A-Za-z0-9\ ._:/@=-]+$ ]] || die "refused: the request contains characters outside the allowed set."
    local words=()
    read -ra words <<<"$request"
    case "${words[0]:-}" in
        deploy|rollback) ;;
        *) die "refused: only 'deploy' and 'rollback' are allowed over SSH." ;;
    esac
    [ "${words[1]:-}" = "$bound_project" ] || die "refused: this key deploys project '$bound_project' only."
    [[ "${words[2]:-}" =~ $COMPONENT_RE ]] && [[ ",$bound_components," == *",${words[2]},"* ]] \
        || die "refused: this key deploys $bound_project/{$bound_components} only."
    local word
    for word in "${words[@]:3}"; do
        case "$word" in
            env=*) die "refused: the environment is the key's, not the request's." ;;
            katap=*) die "refused: katap= is no longer part of a request; this server deploys from the Katap action (see docs/updating.md)." ;;
            migrate=*|*@sha256:*) ;;
            *) die "refused: unexpected word '$word' in the request." ;;
        esac
    done
    words+=("env=$environment")

    # The registry login for this deploy comes on standard input, never in the
    # request: the request is logged, the login is not. At most one line,
    # `registry <user> <token>`, read within 10 seconds and 512 bytes and before
    # any lock is taken, so a client that never closes its input holds nothing.
    # Only a GitHub Actions job token (ghs_…) is accepted: it expires with the job.
    local login='' status=0
    IFS= read -r -t 10 -n 512 login || status=$?
    [ "$status" -le 128 ] || [ -z "$login" ] || die "refused: the registry login did not arrive within 10 seconds."
    login="${login%$'\r'}"
    if [ -n "$login" ]; then
        local word user token extra
        read -r word user token extra <<<"$login"
        [ "$word" = registry ] && [ -z "$extra" ] && [ "$login" = "registry $user $token" ] \
            && [[ "$user" =~ $REGISTRY_USER_RE ]] && [[ "$token" =~ $JOB_TOKEN_RE ]] \
            || die "refused: standard input must be one line, 'registry <user> <GitHub Actions token>'."
        login="$user $token"
    fi

    local client="${SSH_CONNECTION:-}"
    client="${client%% *}"
    command -v logger >/dev/null \
        && logger -t katap "ssh-dispatch env=$environment key=$bound_project/$bound_components client=${client:-local}: $request" || true

    # One dispatch per component at a time, and not again until the cooldown after
    # the last one ended: a replayed or looping key must neither queue workers nor
    # hold its project's lock back to back, which would starve the project's other
    # components and its scheduled jobs. The lock is held by the worker, so it
    # outlives this session as the deploy does. `.dispatch` cannot be a project's
    # state directory: project names start with a letter.
    # Both are kept per key (its binding) as well as per component, so a key bound
    # to several components cannot alternate between them to keep the lock busy.
    local dir log last key cooldown="${KATAP_DISPATCH_COOLDOWN:-60}"
    [[ "$cooldown" =~ ^[0-9]{1,9}$ ]] || die "refused: KATAP_DISPATCH_COOLDOWN must be whole seconds (it is '$cooldown')."
    dir="$KATAP_SRV/state/.dispatch/$bound_project"
    key="key-${bound_components//,/+}"
    umask 077
    mkdir -p "$dir"
    exec 7>"$dir/.${words[2]}.lock"
    flock -n 7 || die "refused: a dispatch for $bound_project/${words[2]} is already running."
    exec 8>"$dir/.$key.lock"
    flock -n 8 || die "refused: a dispatch by this key ($bound_project/{$bound_components}) is already running."
    last="$dir/.$key.last"
    if [ -f "$last" ] && [ $(( $(date +%s) - $(stat -c %Y "$last") )) -lt "$cooldown" ]; then
        die "refused: this key ($bound_project/{$bound_components}) dispatched less than ${cooldown}s ago; try again shortly."
    fi

    # The login reaches the worker in a 0600 file in this 0700 directory, which
    # the worker reads once and removes: never an argument, never the environment
    # of anything but the worker's first instruction.
    local login_file=''
    if [ -n "$login" ]; then
        login_file="$(mktemp "$dir/.registry.XXXXXX")"
        printf '%s\n' "$login" > "$login_file"
        login=''
    fi

    # The work outlives the SSH session: a cancelled workflow or a dropped
    # connection must never stop a deploy between its steps. It runs with HUP and
    # PIPE ignored and its output in a log, which the session follows while it lasts.
    log="$dir/$(date -u +%Y%m%dT%H%M%SZ)-${words[2]}-$$.log"
    : > "$log"
    (
        trap '' HUP PIPE
        status=0
        KATAP_REGISTRY_FILE="$login_file" "$KATAP_SELF" "${words[@]}" >"$log" 2>&1 || status=$?
        [ -z "$login_file" ] || rm -f "$login_file"
        echo "$status" > "$log.status"
        touch "$last"
    ) </dev/null &
    local worker=$!
    exec 7>&- 8>&-
    tail -n +1 --pid="$worker" -f "$log" 2>/dev/null || true
    wait "$worker" 2>/dev/null || true

    # Keep each component's newest 50 logs: no key rotates out another's record.
    local logs=("$dir"/*-"${words[2]}"-*.log) status_file
    while [ "${#logs[@]}" -gt 50 ]; do
        rm -f "${logs[0]}" "${logs[0]}.status"
        logs=("${logs[@]:1}")
    done
    for status_file in "$dir"/*.log.status; do
        [ -e "${status_file%.status}" ] || rm -f "$status_file"
    done
    exit "$(cat "$log.status" 2>/dev/null || echo 1)"
}

# --- main -----------------------------------------------------------------------

main() {
    local command="${1:-help}"
    [ "$#" -eq 0 ] || shift
    case "$command" in
        add) cmd_add "$@" ;;
        secrets) cmd_secrets "$@" ;;
        edge) cmd_edge "$@" ;;
        deploy) cmd_deploy "$@" ;;
        rollback) cmd_rollback "$@" ;;
        run) cmd_run "$@" ;;
        cron) cmd_cron "$@" ;;
        backup) cmd_backup "$@" ;;
        restore) cmd_restore "$@" ;;
        check) cmd_check "$@" ;;
        apply) cmd_apply "$@" ;;
        env) cmd_env "$@" ;;
        deploy-key) cmd_deploy_key "$@" ;;
        remove) cmd_remove "$@" ;;
        images) cmd_images "$@" ;;
        ssh-dispatch) cmd_ssh_dispatch "$@" ;;
        help|-h|--help) awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$KATAP_ROOT/bin/katap" ;;
        *) die "unknown command '$command'; see 'katap help'." ;;
    esac
}

main "$@"
