[Unit]
Description=kit: per-minute jobs of every project (e.g. Laravel's schedule:run)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
EnvironmentFile=-/etc/kit/kit.env
# `kit cron --all` starts one detached process per project and returns at once, so a
# slow job in one project never holds back the next minute of another. process: the
# unit ending must not kill them (each is bounded by KIT_CRON_TIMEOUT, default 10m,
# and skips a minute while its project is busy).
KillMode=process
TimeoutStartSec=30s
ExecStart=/srv/kit/bin/kit cron --all
