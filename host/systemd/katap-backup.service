[Unit]
Description=katap: dump every project database
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
# Settings (KATAP_BACKUP_KEEP, KATAP_RCLONE_REMOTE, …) live in /etc/katap/katap.env,
# which bin/katap reads itself: not loaded here, so the GitHub token in it never
# reaches the environment of every process this unit starts.
# Every project is attempted even when one fails; the unit then fails, which
# `systemctl --failed` and the journal show. Bounded, so a stuck dump cannot keep
# the unit active and silently skip the following nights.
TimeoutStartSec=4h
ExecStart=/srv/katap/bin/katap backup --all
# Release images no longer serving: a rollback pulls its image again by digest.
ExecStartPost=-/usr/bin/docker image prune --all --force --filter until=336h
