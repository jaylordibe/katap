# __C__ (nestjs-api)
__DOMAINS__ {
	import kit_site
	# CORP on the responses the edge serves itself (a 401, an edge 404), which
	# never reach the application's own headers.
	header Cross-Origin-Resource-Policy "same-origin"

	# Swagger: ONE subtree holds the UI, its init script and the JSON/YAML
	# documents (nestjs-api src/configure-http-app.ts). Match the subtree, never a
	# list of files. Production turns Swagger off in the application; on a staging
	# project, protect it here by uncommenting basic_auth (hash with
	# `caddy hash-password`).
	@docs path /api/docs /api/docs/*
	header @docs Cache-Control "no-store"
	# basic_auth @docs {
	# 	staging <bcrypt hash>
	# }

	import kit_proxy __UPSTREAM__
}
