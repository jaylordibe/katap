# The shared edge configuration. Site blocks live with their project, in
# projects/<project>/site.caddy, and every one of them is written as:
#
#     <domains> {
#         import kit_site
#         import kit_proxy <project>-<component>:<port>
#     }
#
# so TLS, headers and the client address are decided here, once, for every site.
# TLS_MODE comes from edge/edge.env.

# No certificate for a site until its project is added, and no Caddy admin
# endpoint beyond the container's loopback (the default).

# --- TLS, per mode ------------------------------------------------------------

(tls_acme) {
	# Automatic HTTPS: issued and renewed by Caddy, nothing to configure.
}

(tls_internal) {
	tls internal
}

# Cloudflare Origin Certificate, and Authenticated Origin Pulls: a TLS handshake
# without Cloudflare's client certificate fails, and any peer outside Cloudflare's
# published ranges is dropped. Together they make the origin reachable only through
# Cloudflare, which is what makes CF-Connecting-IP trustworthy below.
# Ranges: https://www.cloudflare.com/ips-v4 and /ips-v6.
(tls_cloudflare) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/cf-origin-pull-ca.pem
		}
	}
	@kit_not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @kit_not_cloudflare {
		abort
	}
}

# --- The client address, per mode ----------------------------------------------
# Caddy replaces any X-Forwarded-For a client sends with the peer it actually saw,
# so an application trusting Caddy's fixed address gets the real client. Behind
# Cloudflare that peer is a Cloudflare edge, so the caller is taken from
# CF-Connecting-IP instead — safe only because tls_cloudflare admits nobody else.

(client_ip_acme) {
}

(client_ip_internal) {
}

(client_ip_cloudflare) {
	header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
}

# --- What every site gets -----------------------------------------------------

(kit_site) {
	import tls_{$TLS_MODE}
	encode zstd gzip
	header {
		# No `preload` and no `includeSubDomains`: both are commitments for the
		# whole domain that outlive this server. Add them per site deliberately.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# The ONLY reverse_proxy in the edge configuration. A bare reverse_proxy in a site
# block would skip the client-address rule above.
(kit_proxy) {
	reverse_proxy {args[0]} {
		import client_ip_{$TLS_MODE}
		# A deploy recreates the container; hold requests across that gap instead
		# of answering 502.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

import /etc/caddy/projects/*/site.caddy
