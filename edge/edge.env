# Edge settings: the single source for the shared reverse proxy.
#
# Read by `docker compose --env-file` (edge/compose.yml) and by bin/kit (it
# writes CADDY_IP into Node API secrets as their trusted proxy). Change a value
# here, then run `kit edge up`.

# How Caddy gets certificates:
#   acme        Let's Encrypt / ZeroSSL, issued and renewed automatically. Default.
#   cloudflare  Cloudflare Origin Certificate + Authenticated Origin Pulls; only
#               Cloudflare's published ranges may connect. Certificate files go in
#               /srv/edge/certs (see README "Cloudflare mode").
#   internal    Caddy's own local CA. Local testing only: browsers will not trust it.
TLS_MODE=acme

# The shared network every public component joins. Caddy holds a fixed address so
# an application can trust exactly one proxy hop. Docker hands out dynamic
# addresses only from EDGE_IP_RANGE, so nothing else can take CADDY_IP.
EDGE_SUBNET=10.254.0.0/24
EDGE_IP_RANGE=10.254.0.128/25
CADDY_IP=10.254.0.2
